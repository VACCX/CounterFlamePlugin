// ============================================================
// World to Screen
// ============================================================

BOOL CFPlugin_WorldToScreen(float* worldPos, float* screenPos) {
    // Transform world position through view-projection matrix
    float x = worldPos[0];
    float y = worldPos[1];
    float z = worldPos[2];
    
    // Apply combined view-projection transform
    // First apply view matrix
    float vx = g_viewMatrix[0]*x + g_viewMatrix[4]*y + g_viewMatrix[8]*z  + g_viewMatrix[12];
    float vy = g_viewMatrix[1]*x + g_viewMatrix[5]*y + g_viewMatrix[9]*z  + g_viewMatrix[13];
    float vz = g_viewMatrix[2]*x + g_viewMatrix[6]*y + g_viewMatrix[10]*z + g_viewMatrix[14];
    float vw = g_viewMatrix[3]*x + g_viewMatrix[7]*y + g_viewMatrix[11]*z + g_viewMatrix[15];
    
    // Then apply projection matrix
    float px = g_projMatrix[0]*vx + g_projMatrix[4]*vy + g_projMatrix[8]*vz  + g_projMatrix[12]*vw;
    float py = g_projMatrix[1]*vx + g_projMatrix[5]*vy + g_projMatrix[9]*vz  + g_projMatrix[13]*vw;
    float pz = g_projMatrix[2]*vx + g_projMatrix[6]*vy + g_projMatrix[10]*vz + g_projMatrix[14]*vw;
    float pw = g_projMatrix[3]*vx + g_projMatrix[7]*vy + g_projMatrix[11]*vz + g_projMatrix[15]*vw;
    
    if (pw < 0.001f) return NO;  // Behind camera
    
    // Perspective divide
    float ndcX = px / pw;
    float ndcY = py / pw;
    
    // Check bounds
    if (ndcX < -1.0f || ndcX > 1.0f || ndcY < -1.0f || ndcY > 1.0f) return NO;
    
    // Convert to screen coordinates
    screenPos[0] = (ndcX + 1.0f) * 0.5f * g_screenWidth;
    screenPos[1] = (1.0f - (ndcY + 1.0f) * 0.5f) * g_screenHeight;
    
    return YES;
}

// ============================================================
// Drawing primitives (2D screen space)
// ============================================================

// Shared vertex buffers for overlay rendering
// These are read by OverlayWindow.mm's MTKView delegate

#define MAX_VERTICES 65536

static float g_posBuf[MAX_VERTICES * 2];  // x,y interleaved in NDC [-1,1]
static float g_colBuf[MAX_VERTICES * 4];  // r,g,b,a interleaved
static int g_vertexCount = 0;

// Forward declaration
static inline void CFSubmitDraw(void);

static inline vector_float2 CFToNDC(float x, float y) {
    return (vector_float2){
        (x / g_screenWidth) * 2.0f - 1.0f,
        1.0f - (y / g_screenHeight) * 2.0f
    };
}

static void CFAddVertex(float x, float y, float r, float g, float b, float a) {
    if (g_vertexCount >= MAX_VERTICES) return;
    vector_float2 ndc = CFToNDC(x, y);
    g_posBuf[g_vertexCount * 2]     = ndc.x;
    g_posBuf[g_vertexCount * 2 + 1] = ndc.y;
    g_colBuf[g_vertexCount * 4]     = r;
    g_colBuf[g_vertexCount * 4 + 1] = g;
    g_colBuf[g_vertexCount * 4 + 2] = b;
    g_colBuf[g_vertexCount * 4 + 3] = a;
    g_vertexCount++;
}

// Draw a filled rectangle
static void CFDrawFilledRect(float x, float y, float w, float h, float r, float g, float b, float a) {
    if (g_vertexCount + 6 > MAX_VERTICES) return;
    float x2 = x + w, y2 = y + h;
    // Triangle 1
    CFAddVertex(x,  y,  r, g, b, a);
    CFAddVertex(x2, y,  r, g, b, a);
    CFAddVertex(x2, y2, r, g, b, a);
    // Triangle 2
    CFAddVertex(x,  y,  r, g, b, a);
    CFAddVertex(x2, y2, r, g, b, a);
    CFAddVertex(x,  y2, r, g, b, a);
}

// Draw an outlined rectangle
static void CFDrawOutlinedRect(float x, float y, float w, float h, float thickness, float r, float g, float b, float a) {
    // Top
    CFDrawFilledRect(x, y, w, thickness, r, g, b, a);
    // Bottom
    CFDrawFilledRect(x, y + h - thickness, w, thickness, r, g, b, a);
    // Left
    CFDrawFilledRect(x, y, thickness, h, r, g, b, a);
    // Right
    CFDrawFilledRect(x + w - thickness, y, thickness, h, r, g, b, a);
}

// Draw a line (thick)
static void CFDrawLine(float x1, float y1, float x2, float y2, float thickness, float r, float g, float b, float a) {
    float dx = x2 - x1;
    float dy = y2 - y1;
    float len = sqrtf(dx*dx + dy*dy);
    if (len < 0.001f) return;
    
    float nx = -dy / len * thickness * 0.5f;
    float ny = dx / len * thickness * 0.5f;
    
    CFAddVertex(x1 + nx, y1 + ny, r, g, b, a);
    CFAddVertex(x2 + nx, y2 + ny, r, g, b, a);
    CFAddVertex(x2 - nx, y2 - ny, r, g, b, a);
    
    CFAddVertex(x1 + nx, y1 + ny, r, g, b, a);
    CFAddVertex(x2 - nx, y2 - ny, r, g, b, a);
    CFAddVertex(x1 - nx, y1 - ny, r, g, b, a);
}

// Draw a circle (filled)
static void CFDrawFilledCircle(float cx, float cy, float radius, int segments, float r, float g, float b, float a) {
    if (g_vertexCount + (segments + 1) * 3 > MAX_VERTICES) return;
    for (int i = 0; i < segments; i++) {
        float angle1 = (float)i / segments * M_PI * 2.0f;
        float angle2 = (float)(i + 1) / segments * M_PI * 2.0f;
        float x1 = cx + cosf(angle1) * radius;
        float y1 = cy + sinf(angle1) * radius;
        float x2 = cx + cosf(angle2) * radius;
        float y2 = cy + sinf(angle2) * radius;
        CFAddVertex(cx, cy, r, g, b, a);
        CFAddVertex(x1, y1, r, g, b, a);
        CFAddVertex(x2, y2, r, g, b, a);
    }
}

// Draw a circle (outline)
static void CFDrawCircle(float cx, float cy, float radius, int segments, float thickness, float r, float g, float b, float a) {
    float inner = radius - thickness;
    if (inner < 0) inner = 0;
    if (g_vertexCount + segments * 6 > MAX_VERTICES) return;
    
    for (int i = 0; i < segments; i++) {
        float angle1 = (float)i / segments * M_PI * 2.0f;
        float angle2 = (float)(i + 1) / segments * M_PI * 2.0f;
        
        float ox1 = cx + cosf(angle1) * radius;
        float oy1 = cy + sinf(angle1) * radius;
        float ox2 = cx + cosf(angle2) * radius;
        float oy2 = cy + sinf(angle2) * radius;
        
        float ix1 = cx + cosf(angle1) * inner;
        float iy1 = cy + sinf(angle1) * inner;
        float ix2 = cx + cosf(angle2) * inner;
        float iy2 = cy + sinf(angle2) * inner;
        
        // Triangle 1
        CFAddVertex(ox1, oy1, r, g, b, a);
        CFAddVertex(ox2, oy2, r, g, b, a);
        CFAddVertex(ix1, iy1, r, g, b, a);
        // Triangle 2
        CFAddVertex(ox2, oy2, r, g, b, a);
        CFAddVertex(ix2, iy2, r, g, b, a);
        CFAddVertex(ix1, iy1, r, g, b, a);
    }
}

