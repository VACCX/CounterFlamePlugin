/* ============================================================
 * World to Screen projection
 * 
 * Simplified using Camera's WorldToScreenPoint.
 * We'll use the actual Unity Camera API at runtime.
 * ============================================================ */

static Il2CppObject* camera_world_to_screen_point(Il2CppObject* camera, float wx, float wy, float wz) {
    if (!camera) return NULL;
    
    // Find Camera.WorldToScreenPoint method
    static MethodInfo* method = NULL;
    if (!method) {
        Il2CppClass* camera_class = il2cpp_object_get_class(camera);
        if (camera_class) {
            method = il2cpp_class_get_method_from_name(camera_class, "WorldToScreenPoint", 1);
        }
    }
    
    if (!method) return NULL;
    
    // Create Vector3 argument
    // We need to create a UnityEngine.Vector3 value type
    // For IL2CPP, value types can be boxed
    float vec3[3] = { wx, wy, wz };
    
    // Find Vector3 class
    static Il2CppClass* vec3_class = NULL;
    if (!vec3_class) {
        vec3_class = find_class("UnityEngine", "Vector3");
    }
    
    if (!vec3_class) return NULL;
    
    Il2CppObject* boxed_vec3 = il2cpp_value_box(vec3_class, vec3);
    if (!boxed_vec3) return NULL;
    
    void* args[] = { boxed_vec3 };
    Il2CppObject* result = invoke_method(method, camera, args);
    
    return result; // Returns Vector3 (boxed) or null
}

/* ============================================================
 * Get position of a GameObject's Transform
 * ============================================================ */

static int get_transform_position(Il2CppObject* gameObject, float out[3]) {
    if (!gameObject) return -1;
    
    // Find GameObject.transform property
    static FieldInfo* transform_field = NULL;
    if (!transform_field && g_class_GameObject) {
        transform_field = il2cpp_class_get_field_from_name(g_class_GameObject, "transform");
    }
    
    if (!transform_field) {
        // Try GameObject.GetComponent<Transform>()
        // For now, try reading transform field directly
        int offset = get_field_offset(g_class_GameObject, "m_Transform");
        if (offset >= 0) {
            Il2CppObject* transform = *(Il2CppObject**)((uint8_t*)gameObject + offset);
            if (transform) {
                // Read Transform.m_Position (or use get_position method)
                // Transform has m_Position field in newer Unity versions
                Il2CppClass* transform_class = il2cpp_object_get_class(transform);
                int pos_offset = get_field_offset(transform_class, "m_Position");
                if (pos_offset >= 0) {
                    float* p = (float*)((uint8_t*)transform + pos_offset);
                    out[0] = p[0]; out[1] = p[1]; out[2] = p[2];
                    return 0;
                }
            }
        }
        out[0] = out[1] = out[2] = 0.0f;
        return -1;
    }
    
    return -1;
}

