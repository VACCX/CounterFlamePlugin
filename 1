typedef MethodInfo* (*il2cpp_class_get_method_from_name_t)(Il2CppClass* klass, const char* name, int argsCount);
typedef Il2CppObject* (*il2cpp_runtime_invoke_t)(MethodInfo* method, Il2CppObject* obj, void** params, Il2CppObject** exc);
typedef void* (*il2cpp_resolve_icall_t)(const char* name);
typedef Il2CppString* (*il2cpp_string_new_t)(const char* str);
typedef void (*il2cpp_gc_collect_t)(int maxGeneration);
typedef Il2CppObject* (*il2cpp_type_get_object_t)(Il2CppType* type);
typedef Il2CppObject* (*il2cpp_object_new_t)(Il2CppClass* klass);
typedef Il2CppClass* (*il2cpp_object_get_class_t)(Il2CppObject* obj);
typedef Il2CppImage* (*il2cpp_get_corlib_t)(void);
typedef Il2CppObject* (*il2cpp_array_new_t)(Il2CppClass* elementType, size_t length);
typedef size_t (*il2cpp_array_length_t)(Il2CppObject* arr);
