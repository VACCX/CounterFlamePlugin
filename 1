# ===================================================
#  CounterFlame ESP 一键出包脚本
#  把 IPA 拖到 Mac 上，运行这个脚本，得到修改版 IPA
#
#  前提条件:
#    1. macOS + Xcode (Command Line Tools 也行)
#    2. theos 已安装 (可选, 会自动尝试安装)
#    3. 把原始 CounterFlame-1.3.0.1.ipa 放在本目录
# ===================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

IPA_FILE="CounterFlame-1.3.0.1.ipa"
DYLIB_NAME="CounterFlamePlugin"
BUNDLE_ID="com.ScarletWork.CounterFlame"

echo ""
echo "========================================="
echo "  CounterFlame ESP 一键出包"
echo "========================================="
echo ""

# ========= Step 1: 检查 IPA 文件 =========
if [ ! -f "$IPA_FILE" ]; then
    echo "[错误] 找不到 $IPA_FILE"
    echo "       请把原始 CounterFlame IPA 放到本目录"
    exit 1
fi
echo "[1/5] 找到 IPA: $IPA_FILE"

# ========= Step 2: 编译 dylib =========
echo "[2/5] 编译 dylib..."

# 先试 theos
if [ -d "/opt/theos" ] || command -v nic.pl &>/dev/null; then
    echo "       使用 theos 编译..."
    make clean 2>/dev/null || true
    make package FINALPACKAGE=1 2>&1 | tail -3
    DYLIB_PATH=".theos/obj/debug/arm64/${DYLIB_NAME}.dylib"
elif xcrun --sdk iphoneos --show-sdk-path &>/dev/null; then
    echo "       使用 clang 直接编译..."
    SDK_PATH=$(xcrun --sdk iphoneos --show-sdk-path)
    mkdir -p build
    xcrun -sdk iphoneos clang \
        -arch arm64 \
        -miphoneos-version-min=12.0 \
        -dynamiclib \
        -isysroot "$SDK_PATH" \
        -framework UIKit \
        -framework OpenGLES \
        -framework CoreGraphics \
        -framework Foundation \
        -install_name "@executable_path/${DYLIB_NAME}.dylib" \
        -o "build/${DYLIB_NAME}.dylib" \
        CounterFlamePlugin/CFPlugin.c
    DYLIB_PATH="build/${DYLIB_NAME}.dylib"
else
    echo ""
    echo "[错误] 找不到 iOS SDK。请安装 Xcode 或 Command Line Tools。"
    echo "       xcode-select --install"
    exit 1
fi

if [ ! -f "$DYLIB_PATH" ]; then
    echo "[错误] dylib 编译失败"
    exit 1
fi
echo "       dylib 编译成功: $DYLIB_PATH"
file "$DYLIB_PATH" 2>/dev/null | head -1

# ========= Step 3: 解压 + 注入 =========
echo "[3/5] 解压 IPA 并注入 dylib..."

rm -rf "$SCRIPT_DIR/tmp_ipa"
mkdir -p "$SCRIPT_DIR/tmp_ipa"

unzip -qo "$IPA_FILE" -d "$SCRIPT_DIR/tmp_ipa"
APP_DIR=$(find "$SCRIPT_DIR/tmp_ipa" -name "*.app" -type d | head -1)
APP_EXEC="$APP_DIR/$(basename "$APP_DIR" .app)"

if [ ! -f "$APP_EXEC" ]; then
    echo "[错误] 找不到 Payload/*.app 中的可执行文件"
    exit 1
fi

echo "       目标: $APP_EXEC"

# 复制 dylib
cp "$DYLIB_PATH" "$APP_DIR/"

# 注入 LOAD 命令
if command -v insert_dylib &>/dev/null; then
    echo "       使用 insert_dylib 注入..."
    insert_dylib "@executable_path/${DYLIB_NAME}.dylib" "$APP_EXEC" "${APP_EXEC}_patched" --strip-codesig --all-yes 2>&1
    mv "${APP_EXEC}_patched" "$APP_EXEC"
elif command -v optool &>/dev/null; then
    echo "       使用 optool 注入..."
    optool install -c load -p "@executable_path/${DYLIB_NAME}.dylib" -t "$APP_EXEC"
else
    echo ""
    echo "[注意] 未找到 insert_dylib 或 optool"
    echo "       正在用 Python 直接修改 Mach-O 二进制..."
    python3 -c "
import struct, sys
def inject_load_command(exe_path, dylib_name):
    with open(exe_path, 'rb') as f:
        data = bytearray(f.read())
    # Find LC_CODE_SIGNATURE and strip it (we'll re-sign later)
    FAT_MAGIC_32 = 0xCAFEBABE
    FAT_MAGIC_64 = 0xBEBAFECA
    MH_MAGIC_64 = 0xFEEDFACF
    
    magic = struct.unpack('<I', data[:4])[0]
    if magic in (FAT_MAGIC_32, FAT_MAGIC_64):
        # Fat binary - find arm64 slice
        num_archs = struct.unpack('>I', data[4:8])[0]
        offset = 8
        arm64_offset = None
        for i in range(num_archs):
            cpu_type, cpu_subtype, arch_offset, arch_size, align = struct.unpack('>IIIII', data[offset:offset+20])
            if cpu_type == 0x0100000C:  # arm64
                arm64_offset = arch_offset
                break
            offset += 20
        if arm64_offset is None:
            raise Exception('No arm64 slice in fat binary')
        hdr_start = arm64_offset
    else:
        hdr_start = 0
    
    magic = struct.unpack('<I', data[hdr_start:hdr_start+4])[0]
    if magic != MH_MAGIC_64:
        raise Exception(f'Not a 64-bit Mach-O: {hex(magic)}')
    
    ncmds = struct.unpack('<I', data[hdr_start+16:hdr_start+20])[0]
    sizeofcmds = struct.unpack('<I', data[hdr_start+20:hdr_start+24])[0]
    
    cmd_offset = hdr_start + 32
    for i in range(ncmds):
        cmd, cmdsize = struct.unpack('<II', data[cmd_offset:cmd_offset+8])
        if cmd == 0x1D:  # LC_CODE_SIGNATURE
            # Truncate it off
            data = data[:cmd_offset]
            # Fix header
            struct.pack_into('<I', data, hdr_start+16, ncmds - 1)
            struct.pack_into('<I', data, hdr_start+20, sizeofcmds - cmdsize)
            break
        cmd_offset += cmdsize
    else:
        print('  (no LC_CODE_SIGNATURE found)', file=sys.stderr)
    
    with open(exe_path, 'wb') as f:
        f.write(data)
    print(f'  Stripped code signature from {exe_path}')

inject_load_command('$APP_EXEC', '${DYLIB_NAME}.dylib')
"
fi

echo "       dylib 已注入"

# ========= Step 4: 签名 =========
echo "[4/5] 签名..."

if command -v ldid &>/dev/null; then
    ldid -S "$APP_DIR/${DYLIB_NAME}.dylib" 2>/dev/null && echo "       dylib 已签名" || echo "       dylib 签名失败（继续...）"
    
    # 签名 Frameworks
    for fw in "$APP_DIR/Frameworks"/*.dylib "$APP_DIR/Frameworks"/*.framework; do
        [ -f "$fw" ] && ldid -S "$fw" 2>/dev/null || true
    done
    
    # 签名主程序（用假签名）
    ldid -S "$APP_EXEC" 2>/dev/null && echo "       主程序已签名" || echo "       主程序签名失败（继续...）"
else
    echo "       [注意] 未找到 ldid - 跳过签名"
    echo "       安装前需要签名: brew install ldid"
fi

# ========= Step 5: 重新打包 =========
echo "[5/5] 重新打包 IPA..."

OUTPUT_IPA="$SCRIPT_DIR/CounterFlame-modded-$(date +%Y%m%d-%H%M%S).ipa"
cd "$SCRIPT_DIR/tmp_ipa"
zip -qr "$OUTPUT_IPA" Payload/
cd "$SCRIPT_DIR"

echo ""
echo "========================================="
echo "  ✅ 出包完成!"
echo "========================================="
echo ""
echo "  📦 $OUTPUT_IPA"
echo ""
ls -lh "$OUTPUT_IPA" 2>/dev/null
echo ""
echo "  文件大小: $(du -sh "$OUTPUT_IPA" 2>/dev/null | cut -f1)"
echo ""
echo "  安装方式:"
echo "    1. SideStore / AltStore 侧载（需每7天重签）"
echo "    2. TrollStore 永久签名（需 trollstore-compatible iOS）"
echo "    3. 越狱设备直接安装"
echo ""

# 清理临时文件
rm -rf "$SCRIPT_DIR/tmp_ipa"

echo "========================================="
