void CFPlugin_Init(void) {
    if (g_initialized) return;
    
    NSLog(@"[CFPlugin] ========================================");
    NSLog(@"[CFPlugin] CounterFlame ESP Plugin v1.0");
    NSLog(@"[CFPlugin] Initializing...");
    
    // Load config
    CFPlugin_ReloadConfig();
    
    // Initialize the overlay window (transparent UIWindow + MTKView)
    // This is the most reliable approach - no Metal hooking needed
    CFOverlay_Init();
    
    // Try to get Metal device from the system
    g_metalDevice = MTLCreateSystemDefaultDevice();
    if (g_metalDevice) {
        CFInitMetal(g_metalDevice);
    } else {
        NSLog(@"[CFPlugin] Warning: Could not create Metal device");
    }
    
    g_initialized = YES;
    NSLog(@"[CFPlugin] Initialization complete");
    NSLog(@"[CFPlugin] ========================================");
}

void CFPlugin_Shutdown(void) {
    g_initialized = NO;
    g_readyToDraw = 0;
    g_overlayVertexCount = 0;
    CFOverlay_Shutdown();
    NSLog(@"[CFPlugin] Shutdown");
}

