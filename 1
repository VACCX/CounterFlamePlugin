#!/usr/bin/env python3
"""
CounterFlame IPA Repackaging Script for Windows
================================================

This script injects a compiled dylib into the CounterFlame IPA.
Use it AFTER building the dylib on macOS with theos.

Usage:
  1. Build the dylib on macOS:  cd CounterFlamePlugin && make package
  2. Copy CounterFlamePlugin.dylib to this directory
  3. Run: python inject_dylib.py

The script will:
  - Extract the IPA
  - Replace/add the dylib to CounterFlame.app
  - Fix the Mach-O binary to load the dylib
  - Update Info.plist if needed
  - Repack the IPA
  - Optionally sign with a development certificate
"""

import os
import sys
import shutil
import subprocess
import struct
import zipfile
import tempfile
from pathlib import Path

# ============================================================
# Configuration
# ============================================================

IPA_PATH = "CounterFlame-1.3.0.1.ipa"
DYLIB_PATH = "CounterFlamePlugin.dylib"
OUTPUT_IPA = "CounterFlame-1.3.0.1-modded.ipa"
APP_NAME = "CounterFlame.app"
BINARY_NAME = "CounterFlame"
ENTITLEMENTS = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.team-identifier</key>
    <string>YOUR_TEAM_ID</string>
    <key>application-identifier</key>
    <string>YOUR_TEAM_ID.com.XFGame.CounterFlame</string>
    <key>keychain-access-groups</key>
    <array>
        <string>YOUR_TEAM_ID.*</string>
    </array>
    <key>get-task-allow</key>
    <true/>
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>"""

# ============================================================
# Main
# ============================================================

def step(msg):
    print(f"\n{'='*60}")
    print(f"  {msg}")
    print(f"{'='*60}")

def run(cmd):
    print(f"  $ {cmd}")
    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"  WARNING: command failed: {result.stderr[:500]}")
    else:
        if result.stdout.strip():
            print(result.stdout[:2000])
    return result

def main():
    workdir = Path(tempfile.mkdtemp(prefix="cf_inject_"))
    print(f"Working directory: {workdir}")
    
    try:
        # Step 1: Extract IPA
        step("1. Extracting IPA")
        ipa_path = Path(IPA_PATH)
        if not ipa_path.exists():
            print(f"ERROR: {IPA_PATH} not found!")
            print("Please place the IPA file in the current directory.")
            sys.exit(1)
        
        with zipfile.ZipFile(ipa_path, 'r') as z:
            z.extractall(workdir)
        
        payload = workdir / "Payload"
        if not payload.exists():
            print("ERROR: No Payload directory in IPA!")
            sys.exit(1)
        
        app_dirs = list(payload.glob("*.app"))
        if not app_dirs:
            print("ERROR: No .app bundle in Payload!")
            sys.exit(1)
        
        app_dir = app_dirs[0]
        print(f"App bundle: {app_dir.name}")
        
        # Step 2: Check dylib
        step("2. Checking dylib")
        dylib = Path(DYLIB_PATH)
        if not dylib.exists():
            print(f"NOTE: {DYLIB_PATH} not found in current directory.")
            print("This step will be skipped. Build the dylib on macOS first.")
            print("Then re-run this script.")
        else:
            # Copy dylib into the app bundle
            dest = app_dir / DYLIB_PATH
            shutil.copy2(dylib, dest)
            print(f"Dylib copied to: {dest}")
        
        # Step 3: Patch binary to load dylib
        step("3. Patching binary to load dylib")
        binary = app_dir / BINARY_NAME
        if not binary.exists():
            print(f"WARNING: {BINARY_NAME} not found. The app may use a different binary name.")
            print("Checking for other executables...")
            exes = [f for f in app_dir.iterdir() if not f.suffix and os.access(f, os.X_OK)]
            for e in exes:
                print(f"  Found executable: {e.name}")
        else:
            print(f"Binary: {binary} ({binary.stat().st_size} bytes)")
            print()
            print("IMPORTANT: Patching the Mach-O binary requires macOS tools.")
            print("On macOS, run the following commands after transferring the")
            print("extracted app bundle to a Mac:")
            print()
            print(f"  # Install the dylib load command into the binary:")
            print(f"  install_name_tool -change @executable_path/{DYLIB_PATH} \\")
            print(f"                    @executable_path/{DYLIB_PATH} \\")
            print(f"                    {binary}")
            print()
            print(f"  # OR use optool:")
            print(f"  optool install -p @executable_path/{DYLIB_PATH} \\")
            print(f"                 -t {binary}")
            print()
            print(f"  # OR use insert_dylib:")
            print(f"  insert_dylib @executable_path/{DYLIB_PATH} {binary} \\")
            print(f"               {binary}_patched --strip-codesig")
            print(f"  mv {binary}_patched {binary}")
            print()
            print("Alternative: For jailbroken devices, use a substrate loader:")
            print("  - Copy dylib to the app's Frameworks directory")
            print("  - Add LC_LOAD_DYLIB command to the binary")
        
        # Step 4: Create Frameworks directory if needed
        step("4. Setting up Frameworks")
        frameworks_dir = app_dir / "Frameworks"
        frameworks_dir.mkdir(exist_ok=True)
        
        # Step 5: Repack IPA
        step("5. Repacking IPA")
        output = Path(OUTPUT_IPA)
        
        # Remove old output
        if output.exists():
            output.unlink()
        
        with zipfile.ZipFile(output, 'w', zipfile.ZIP_DEFLATED) as z:
            for root, dirs, files in os.walk(workdir):
                for file in files:
                    file_path = Path(root) / file
                    arcname = file_path.relative_to(workdir)
                    if '__MACOSX' in str(arcname):
                        continue
                    z.write(file_path, arcname)
        
        print(f"Output IPA: {output} ({output.stat().st_size} bytes)")
        
        # Step 6: Summary
        step("6. Summary & Next Steps")
        print(f"""
CounterFlame ESP Plugin - Build & Injection Guide
===================================================

COMPILING THE PLUGIN (on macOS):
  1. Install theos:
     bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)"
     
  2. Navigate to the CounterFlamePlugin directory:
     cd CounterFlamePlugin
     
  3. Build the dylib:
     make package
     
  4. Find the compiled dylib at:
     .theos/obj/debug/arm64/CounterFlamePlugin.dylib

INJECTING INTO IPA (on macOS):
  1. Unzip the IPA:
     unzip CounterFlame-1.3.0.1.ipa -d extracted
     
  2. Copy the dylib into the .app bundle:
     cp CounterFlamePlugin.dylib extracted/Payload/CounterFlame.app/
     
  3. Add dylib load command to the binary:
     # Using insert_dylib (recommended):
     brew install insert_dylib  # or build from source
     insert_dylib @executable_path/CounterFlamePlugin.dylib \\
                  extracted/Payload/CounterFlame.app/CounterFlame \\
                  extracted/Payload/CounterFlame.app/CounterFlame_patched \\
                  --strip-codesig --all-yes
     mv extracted/Payload/CounterFlame.app/CounterFlame_patched \\
        extracted/Payload/CounterFlame.app/CounterFlame
     
  4. (Optional) Sign with a development certificate:
     codesign -f -s "iPhone Developer: Your Name" \\
              extracted/Payload/CounterFlame.app/CounterFlamePlugin.dylib
     codesign -f -s "iPhone Developer: Your Name" \\
              --entitlements entitlements.plist \\
              extracted/Payload/CounterFlame.app
     
  5. Repack:
     cd extracted
     zip -r ../CounterFlame-1.3.0.1-modded.ipa Payload/
     
  6. Install via AltStore, Sideloadly, or Filza (jailbroken).

SIGNING FOR NON-JAILBROKEN DEVICES (Sideloading):
  Use ldid for signing (works without Apple Developer account):
  
  brew install ldid
  
  # Sign the dylib
  ldid -S CounterFlamePlugin.dylib
  
  # Sign the entire app
  ldid -S extracted/Payload/CounterFlame.app/CounterFlame
  ldid -S extracted/Payload/CounterFlame.app/CounterFlamePlugin.dylib

REQUIRED TOOLS:
  - theos (for compilation)
  - insert_dylib or optool (for binary patching)
  - ldid or codesign (for signing)
  - AltStore / Sideloadly / Xcode (for side-loading)
  - or Filza / iFile (for jailbroken installation)

TROUBLESHOOTING:
  - If the app crashes on launch: check iOS version compatibility
  - If ESP doesn't show: ensure IL2CPP domain initialization completed
  - Check device logs: idevicesyslog | grep CFPlugin
  - The plugin logs to NSLog with [CFPlugin] prefix
""")
        
    finally:
        # Cleanup
        print(f"\nTemporary files at: {workdir}")
        # Uncomment to auto-clean:
        # shutil.rmtree(workdir, ignore_errors=True)

if __name__ == '__main__':
    main()
