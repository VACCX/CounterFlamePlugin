/* ============================================================
 * Collect player info from the scene
 * ============================================================ */

static void collect_players(void) {
    g_player_count = 0;
    g_main_camera = get_main_camera();
    
    if (!g_main_camera) {
        return;
    }
    
    // Strategy: Iterate Photon .PlayerList for all players
    // then find their GameObjects and extract info
    
    Il2CppObject* photon_network = NULL;
    
    // Get PhotonNetwork instance (singleton)
    // PhotonNetwork has a static field for CurrentRoom
    if (g_class_PUN_Utility) {
        // Alternative: PhotonNetwork.PlayerList is static
        FieldInfo* pl_field = il2cpp_class_get_field_from_name(g_class_PUN_Utility, "PlayerList");
        if (!pl_field && g_class_PhotonPlayer) {
            // Try PhotonNetwork static fields
        }
    }
    
    // For now, use a simplified approach:
    // Find all GameObjects with PlayerLife component
    
    // Actually, let's try GameObject.FindGameObjectsWithTag("Player")
    // or find by component type
    
    if (!g_class_PlayerLife) {
        LOG("PlayerLife class not found - ESP will be disabled");
        return;
    }
    
    // Use Object.FindObjectsOfType
    static MethodInfo* find_objects_method = NULL;
    if (!find_objects_method && g_class_Object) {
        find_objects_method = il2cpp_class_get_method_from_name(
            g_class_Object, "FindObjectsOfType", 1);
    }
    
    if (!find_objects_method) return;
    
    // Get the Type object for PlayerLife
    // In IL2CPP, we can use System.Type.GetType or the Il2CppType
    Il2CppImage* game_asm = g_game_assembly;
    if (!game_asm) return;
    
    Il2CppClass* type_class = find_class("System", "Type");
    if (type_class) {
        // We need to get the Type for PlayerLife
        // System.Type.GetType("ScarletWork.Game.Life.PlayerLife, Assembly-CSharp")
        
        static MethodInfo* gettype_method = NULL;
        if (!gettype_method) {
            gettype_method = il2cpp_class_get_method_from_name(type_class, "GetType", 1);
        }
        
        if (gettype_method) {
            const char* type_name = "ScarletWork.Game.Life.PlayerLife, Assembly-CSharp";
            Il2CppString* type_str = il2cpp_string_new(type_name);
            void* args[] = { type_str };
            Il2CppObject* player_life_type = il2cpp_runtime_invoke(gettype_method, NULL, args, NULL);
            
            if (player_life_type) {
                void* fargs[] = { player_life_type };
                Il2CppObject* result = il2cpp_runtime_invoke(find_objects_method, NULL, fargs, NULL);
                
                if (result) {
                    // result is an Array of PlayerLife components
                    uint32_t len = (uint32_t)il2cpp_array_length(result);
                    
                    for (uint32_t i = 0; i < len && g_player_count < MAX_PLAYERS; i++) {
                        // Array.GetValue(i)
                        Il2CppObject* player_life = *(Il2CppObject**)((uint8_t*)result + 0x20 + i * 8);
                        if (!player_life) continue;
                        
                        player_info_t* pi = &g_players[g_player_count];
                        memset(pi, 0, sizeof(player_info_t));
                        
                        // Read health
                        pi->health = read_field_float(player_life, g_class_PlayerLife, "health");
                        pi->maxHealth = read_field_float(player_life, g_class_PlayerLife, "maxHealth");
                        pi->isAlive = read_field_bool(player_life, g_class_PlayerLife, "isAlive");
                        
                        if (!pi->isAlive && pi->health <= 0) continue;
                        
                        // Get the GameObject (PlayerLife is a MonoBehaviour, so it has .gameObject)
                        Il2CppClass* pl_class = il2cpp_object_get_class(player_life);
                        Il2CppObject* go = read_field_obj(player_life, pl_class, "gameObject");
                        pi->gameObject = go;
                        
                        if (go) {
                            // Get position
                            get_transform_position(go, (float*)&pi->worldPos);
                            
                            // Get name
                            const char* go_name = read_string_field(go, g_class_GameObject, "name");
                            if (go_name) {
                                strncpy(pi->name, go_name, 63);
                            }
                        }
                        
                        // Project to screen
                        Il2CppObject* screen_pos = camera_world_to_screen_point(
                            g_main_camera, 
                            pi->worldPos.x, pi->worldPos.y + 1.8f, pi->worldPos.z);
                        
                        if (screen_pos) {
                            float* sp = (float*)il2cpp_object_unbox(screen_pos);
                            if (sp) {
                                pi->screenPos.x = sp[0];
                                pi->screenPos.y = sp[1];
                                pi->screenPos.z = sp[2];
                            }
                        }
                        
                        // Head position
                        Il2CppObject* head_screen = camera_world_to_screen_point(
                            g_main_camera,
                            pi->worldPos.x, pi->worldPos.y + 1.8f, pi->worldPos.z);
                        if (head_screen) {
                            float* hp = (float*)il2cpp_object_unbox(head_screen);
                            if (hp) {
                                pi->headScreen.x = hp[0];
                                pi->headScreen.y = hp[1];
                            }
                        }
                        
                        g_player_count++;
                    }
                }
            }
        }
    }
}

/* ============================================================
 * ESP Drawing using OpenGL ES
 * 
 * We hook into the rendering pipeline to draw directly.
 * Alternative: use Unity's GL class for drawing.
 * ============================================================ */

#include <OpenGLES/ES2/gl.h>
#include <OpenGLES/ES2/glext.h>

static void draw_box_corner(float x, float y, float w, float h, uint32_t color, float thickness) {
    float r = ((color >> 16) & 0xFF) / 255.0f;
    float g = ((color >> 8) & 0xFF) / 255.0f;
    float b = (color & 0xFF) / 255.0f;
    float a = ((color >> 24) & 0xFF) / 255.0f;
    
    float corner_len = fminf(w, h) * 0.25f;
    float t = thickness;
    
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glLineWidth(t);
    glColor4f(r, g, b, a);
    
    // Top-left corner
    GLfloat tl[] = {
        x, y, x + corner_len, y,
        x, y, x, y + corner_len,
    };
    // Top-right corner
    GLfloat tr[] = {
        x + w - corner_len, y, x + w, y,
        x + w, y, x + w, y + corner_len,
    };
    // Bottom-left corner
    GLfloat bl[] = {
        x, y + h - corner_len, x, y + h,
        x, y + h, x + corner_len, y + h,
    };
    // Bottom-right corner
    GLfloat br[] = {
        x + w - corner_len, y + h, x + w, y + h,
        x + w, y + h - corner_len, x + w, y + h,
    };
    
    glVertexPointer(2, GL_FLOAT, 0, tl);
    glEnableClientState(GL_VERTEX_ARRAY);
    glDrawArrays(GL_LINES, 0, 4);
    
    glVertexPointer(2, GL_FLOAT, 0, tr);
    glDrawArrays(GL_LINES, 0, 4);
    
    glVertexPointer(2, GL_FLOAT, 0, bl);
    glDrawArrays(GL_LINES, 0, 4);
    
    glVertexPointer(2, GL_FLOAT, 0, br);
    glDrawArrays(GL_LINES, 0, 4);
    
    glDisableClientState(GL_VERTEX_ARRAY);
    glDisable(GL_BLEND);
}

static void draw_line(float x1, float y1, float x2, float y2, uint32_t color, float thickness) {
    float r = ((color >> 16) & 0xFF) / 255.0f;
    float g = ((color >> 8) & 0xFF) / 255.0f;
    float b = (color & 0xFF) / 255.0f;
    float a = ((color >> 24) & 0xFF) / 255.0f;
    
    GLfloat verts[] = { x1, y1, x2, y2 };
    
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glLineWidth(thickness);
    glColor4f(r, g, b, a);
    
    glVertexPointer(2, GL_FLOAT, 0, verts);
    glEnableClientState(GL_VERTEX_ARRAY);
    glDrawArrays(GL_LINES, 0, 2);
    glDisableClientState(GL_VERTEX_ARRAY);
    
    glDisable(GL_BLEND);
}

static void draw_esp_for_player(player_info_t* pi) {
    if (!pi || !pi->isAlive) return;
    
    float x = pi->screenPos.x;
    float y = pi->screenPos.y;
    float z = pi->screenPos.z;
    
    // Skip if behind camera
    if (z <= 0) return;
    
    // Calculate box
    float hw = g_screen_height / z;  // half-height based on distance
    float h = hw * 1.8f;
    float w = h * 0.55f;
    float box_x = x - w / 2.0f;
    float box_y = y - h;
    
    // Clamp to screen
    if (box_x + w < 0 || box_x > g_screen_width ||
        box_y + h < 0 || box_y > g_screen_height) {
        return;
    }
    
    uint32_t color;
    if (pi->team == 1) {
        color = g_color_box_team1;
    } else if (pi->team == 2) {
        color = g_color_box_team2;
    } else {
        // Color based on health
        float ratio = pi->health / fmaxf(pi->maxHealth, 1.0f);
        if (ratio > 0.7f)      color = 0xFF44FF44;
        else if (ratio > 0.3f) color = 0xFFFFFF44;
        else                   color = 0xFFFF4444;
    }
    
    // Draw corner box
    draw_box_corner(box_x, box_y, w, h, color, 2.0f);
    
    // Health bar (left side)
    float bar_x = box_x - 6.0f;
    float bar_y = box_y;
    float bar_w = 3.0f;
    float bar_h = h;
    float health_ratio = pi->health / fmaxf(pi->maxHealth, 1.0f);
    
    // Background
    draw_line(bar_x, bar_y, bar_x, bar_y + bar_h, 0x88000000, bar_w);
    // Health fill
    float fill_h = bar_h * health_ratio;
    uint32_t health_color;
    if (health_ratio > 0.7f)      health_color = 0xFF44FF44;
    else if (health_ratio > 0.3f) health_color = 0xFFFFFF44;
    else                          health_color = 0xFFFF4444;
    draw_line(bar_x, bar_y + bar_h - fill_h, bar_x, bar_y + bar_h, health_color, bar_w);
    
    // Snapline from bottom center
    float bottom_x = g_screen_width / 2.0f;
    float bottom_y = g_screen_height;
    draw_line(bottom_x, bottom_y, x, box_y + h, 0x88000000, 1.0f);
    
    // Head circle
    // (OpenGL circle is complex, skip for now)
    // We'll use a small cross at head position
    float hx = pi->headScreen.x;
    float hy = pi->headScreen.y;
    if (hx > 0 && hy > 0) {
        float r = hw * 0.15f;
        // Small cross
        draw_line(hx - r, hy, hx + r, hy, 0xFFFFFFFF, 1.5f);
        draw_line(hx, hy - r, hx, hy + r, 0xFFFFFFFF, 1.5f);
    }
}

/* ============================================================
 * Main ESP render function
 * Called from our hook into the rendering pipeline
 * ============================================================ */

static void draw_esp(void) {
    if (!g_initialized) return;
    
    // Save GL state
    glPushAttrib(GL_ALL_ATTRIB_BITS);
    glMatrixMode(GL_PROJECTION);
    glPushMatrix();
    glMatrixMode(GL_MODELVIEW);
    glPushMatrix();
    
    // Set up orthographic projection for screen-space drawing
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    glOrthof(0, g_screen_width, g_screen_height, 0, -1, 1);
    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();
    
    glDisable(GL_DEPTH_TEST);
    glDisable(GL_CULL_FACE);
    
    // Collect players and draw
    collect_players();
    
    for (int i = 0; i < g_player_count; i++) {
        draw_esp_for_player(&g_players[i]);
    }
    
    // Restore GL state
    glMatrixMode(GL_PROJECTION);
    glPopMatrix();
    glMatrixMode(GL_MODELVIEW);
    glPopMatrix();
    glPopAttrib();
}

/* ============================================================
 * Hook setup
 * 
 * We hook into Camera.OnPostRender to draw after each camera render.
 * This is the standard approach for Unity ESP plugins.
 * ============================================================ */

// Original function pointer for the hooked method
static void (*original_OnPostRender)(Il2CppObject* self) = NULL;

// Our hook function
static void hooked_OnPostRender(Il2CppObject* camera) {
    // Call original first
    if (original_OnPostRender) {
        original_OnPostRender(camera);
    }
    
    // Check if this is the main camera
    if (camera == g_main_camera) {
        draw_esp();
    }
}

