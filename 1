static NSString* CFConfigPath(void) {
    NSArray* paths = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES);
    NSString* docsPath = [paths firstObject];
    return [docsPath stringByAppendingPathComponent:@"cfplugin_config.json"];
}

void CFPlugin_ReloadConfig(void) {
    NSString* path = CFConfigPath();
    NSData* data = [NSData dataWithContentsOfFile:path];
    if (!data) return;
    
    NSError* error = nil;
    NSDictionary* json = [NSJSONSerialization JSONObjectWithData:data options:0 error:&error];
    if (error || !json) return;
    
    if (json[@"enabled"]) g_config.enabled = [json[@"enabled"] boolValue];
    if (json[@"drawBox"]) g_config.drawBox = [json[@"drawBox"] boolValue];
    if (json[@"drawSkeleton"]) g_config.drawSkeleton = [json[@"drawSkeleton"] boolValue];
    if (json[@"drawLine"]) g_config.drawLine = [json[@"drawLine"] boolValue];
    if (json[@"drawName"]) g_config.drawName = [json[@"drawName"] boolValue];
    if (json[@"drawDistance"]) g_config.drawDistance = [json[@"drawDistance"] boolValue];
    if (json[@"drawHealth"]) g_config.drawHealth = [json[@"drawHealth"] boolValue];
    if (json[@"drawHead"]) g_config.drawHead = [json[@"drawHead"] boolValue];
    if (json[@"drawInfo"]) g_config.drawInfo = [json[@"drawInfo"] boolValue];
    if (json[@"lineWidth"]) g_config.lineWidth = [json[@"lineWidth"] floatValue];
    if (json[@"fontSize"]) g_config.fontSize = [json[@"fontSize"] floatValue];
    if (json[@"maxDistance"]) g_config.maxDistance = [json[@"maxDistance"] floatValue];
    
    // Parse colors
    NSDictionary* colors = json[@"colors"];
    if (colors) {
        NSArray* c;
        if ((c = colors[@"boxVisible"])) for(int i=0;i<4&&i<c.count;i++) g_config.boxColorVisible[i]=[c[i] floatValue];
        if ((c = colors[@"boxHidden"])) for(int i=0;i<4&&i<c.count;i++) g_config.boxColorHidden[i]=[c[i] floatValue];
        if ((c = colors[@"skeletonVisible"])) for(int i=0;i<4&&i<c.count;i++) g_config.skeletonColorVisible[i]=[c[i] floatValue];
        if ((c = colors[@"skeletonHidden"])) for(int i=0;i<4&&i<c.count;i++) g_config.skeletonColorHidden[i]=[c[i] floatValue];
        if ((c = colors[@"line"])) for(int i=0;i<4&&i<c.count;i++) g_config.lineColor[i]=[c[i] floatValue];
        if ((c = colors[@"name"])) for(int i=0;i<4&&i<c.count;i++) g_config.nameColor[i]=[c[i] floatValue];
        if ((c = colors[@"distance"])) for(int i=0;i<4&&i<c.count;i++) g_config.distanceColor[i]=[c[i] floatValue];
        if ((c = colors[@"head"])) for(int i=0;i<4&&i<c.count;i++) g_config.headColor[i]=[c[i] floatValue];
        if ((c = colors[@"info"])) for(int i=0;i<4&&i<c.count;i++) g_config.infoColor[i]=[c[i] floatValue];
    }
    
    NSLog(@"[CFPlugin] Configuration reloaded");
}

