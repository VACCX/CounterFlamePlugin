static void draw_line(float x1, float y1, float x2, float y2, float r, float g, float b, float a, float w) {
    GLfloat v[] = { x1, y1, x2, y2 };
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glLineWidth(w);
    glColor4f(r, g, b, a);
    glVertexPointer(2, GL_FLOAT, 0, v);
    glEnableClientState(GL_VERTEX_ARRAY);
    glDrawArrays(GL_LINES, 0, 2);
    glDisableClientState(GL_VERTEX_ARRAY);
    glDisable(GL_BLEND);
}

// RGBA packed uint32
static void draw_line_c(float x1, float y1, float x2, float y2, uint32_t c, float w) {
    draw_line(x1, y1, x2, y2,
        ((c>>16)&0xFF)/255.0f, ((c>>8)&0xFF)/255.0f, (c&0xFF)/255.0f, ((c>>24)&0xFF)/255.0f, w);
}

static void draw_rect(float x, float y, float w, float h, uint32_t c, float t) {
    // top
    draw_line_c(x, y, x+w, y, c, t);
    // bottom
    draw_line_c(x, y+h, x+w, y+h, c, t);
    // left
    draw_line_c(x, y, x, y+h, c, t);
    // right
    draw_line_c(x+w, y, x+w, y+h, c, t);
}

static void draw_corner_box(float x, float y, float w, float h, uint32_t c, float t) {
    float cl = fminf(w, h) * 0.25f;
    // Top-left
    draw_line_c(x, y, x+cl, y, c, t);
    draw_line_c(x, y, x, y+cl, c, t);
    // Top-right
    draw_line_c(x+w-cl, y, x+w, y, c, t);
    draw_line_c(x+w, y, x+w, y+cl, c, t);
    // Bottom-left
    draw_line_c(x, y+h-cl, x, y+h, c, t);
    draw_line_c(x, y+h, x+cl, y+h, c, t);
    // Bottom-right
    draw_line_c(x+w-cl, y+h, x+w, y+h, c, t);
    draw_line_c(x+w, y+h-cl, x+w, y+h, c, t);
}

static void draw_bar(float x, float y, float w, float h, float fill, uint32_t bg, uint32_t fg) {
    draw_rect(x, y, w, h, bg, w); // border
    float fy = y + h * (1.0f - fill);
    draw_line_c(x+1, fy, x+w-1, fy, fg, w);
    draw_line_c(x+1, fy, x+1, y+h-1, fg, w);
    draw_line_c(x+w-1, fy, x+w-1, y+h-1, fg, w);
}

/* ============================================================
 * Main ESP render
 * ============================================================ */
static void render_esp(void) {
    if (!g_initialized || !g_esp_enabled) return;

    // Save GL state
    glPushAttrib(GL_ALL_ATTRIB_BITS);
    glMatrixMode(GL_PROJECTION);
    glPushMatrix();
    glMatrixMode(GL_MODELVIEW);
    glPushMatrix();

    // Orthographic projection for screen-space
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    glOrthof(0, g_screenW, g_screenH, 0, -1, 1);
    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();

    glDisable(GL_DEPTH_TEST);

    collect_players();

    for (int i = 0; i < g_playerCount; i++) {
        PlayerInfo* p = &g_players[i];
        if (p->screenPos[2] <= 0) continue; // behind camera

        float x = p->screenPos[0];
        float y = p->screenPos[1];
        float z = p->screenPos[2];

        // Box size based on distance
        float h = (g_screenH / z) * 1.8f;
        float w = h * 0.55f;
        float bx = x - w/2;
        float by = y - h;

        // Skip if off-screen
        if (bx + w < 0 || bx > g_screenW || by + h < 0 || by > g_screenH) continue;

        // Color by team
        uint32_t boxClr;
        if (p->team == 1)      boxClr = 0xFF4444FF;
        else if (p->team == 2) boxClr = 0xFF4488FF;
        else {
            float r = p->health / fmaxf(p->maxHealth, 1);
            if (r > 0.7f)      boxClr = 0xFF44FF44;
            else if (r > 0.3f) boxClr = 0xFFFFFF44;
            else               boxClr = 0xFFFF4444;
        }

        // Corner box
        draw_corner_box(bx, by, w, h, boxClr, 2.0f);

        // Health bar (left side)
        float healthFill = p->health / fmaxf(p->maxHealth, 1);
        uint32_t hClr;
        if (healthFill > 0.7f)      hClr = 0xFF44FF44;
        else if (healthFill > 0.3f) hClr = 0xFFFFFF44;
        else                         hClr = 0xFFFF4444;
        draw_bar(bx - 6, by, 3, h, healthFill, 0x88000000, hClr);

        // Snapline
        draw_line_c(g_screenW/2, g_screenH, x, by+h, 0x88000000, 1.0f);

        // Head dot
        if (p->headScreen[2] > 0) {
            float hr = h * 0.08f;
            draw_line_c(p->headScreen[0] - hr, p->headScreen[1],
                       p->headScreen[0] + hr, p->headScreen[1], 0xFFFFFFFF, 1.5f);
        }
    }

    // Restore GL
    glMatrixMode(GL_PROJECTION);
    glPopMatrix();
    glMatrixMode(GL_MODELVIEW);
    glPopMatrix();
    glPopAttrib();
}

/* ============================================================
 * Hook: Camera.OnPostRender
 * ============================================================ */
static void (*orig_OnPostRender)(void*, SEL, void*) = NULL;

static void hook_OnPostRender(id self, SEL _cmd, void* sender) {
    if (orig_OnPostRender) orig_OnPostRender(self, _cmd, sender);
    // Only draw on main camera's render
    render_esp();
}

/* ============================================================
 * Initialize when dylib loads
 * ============================================================ */
%ctor {
    NSLog(@"[CFPlugin] ====== Loading CounterFlame ESP Plugin v1.3 ======");

    // Wait for game to fully initialize IL2CPP
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
        NSLog(@"[CFPlugin] Resolving il2cpp symbols...");

        RESOLVE(il2cpp_domain_get);
        RESOLVE(il2cpp_domain_get_assemblies);
        RESOLVE(il2cpp_assembly_get_image);
        RESOLVE(il2cpp_class_from_name);
        RESOLVE(il2cpp_object_get_class);
        RESOLVE(il2cpp_class_get_parent);
        RESOLVE(il2cpp_class_get_name);
        RESOLVE(il2cpp_class_get_field_from_name);
        RESOLVE(il2cpp_field_get_offset);
        RESOLVE(il2cpp_field_static_get_value);
        RESOLVE(il2cpp_class_get_method_from_name);
        RESOLVE(il2cpp_runtime_invoke);
        RESOLVE(il2cpp_string_new);
        RESOLVE(il2cpp_object_new);
        RESOLVE(il2cpp_value_box);
        RESOLVE(il2cpp_object_unbox);
        RESOLVE(il2cpp_array_new);
        RESOLVE(il2cpp_array_length);
        RESOLVE(il2cpp_get_corlib);

        if (!il2cpp_domain_get) {
            NSLog(@"[CFPlugin] FATAL: not an IL2CPP game?");
            return;
        }

        // Cache core Unity classes
        g_class_Camera     = find_class("UnityEngine", "Camera");
        g_class_GameObject = find_class("UnityEngine", "GameObject");
        g_class_Transform  = find_class("UnityEngine", "Transform");
        g_class_Object     = find_class("UnityEngine", "Object");
        g_class_Vector3    = find_class("UnityEngine", "Vector3");

        // Cache game classes
        g_class_PlayerLife      = find_class("ScarletWork.Game.Life", "PlayerLife");
        g_class_PhotonPlayer    = find_class("Photon.Realtime", "Player");
        g_class_PhotonNetwork   = find_class("Photon.Pun", "PhotonNetwork");
        g_class_PlayerNumbering = find_class("Photon.Pun.UtilityScripts", "PlayerNumbering");
        g_class_PlayerSkeleton  = find_class("ScarletWork.Game", "PlayerSkeleton");
        g_class_PlayerBar       = find_class("ScarletWork.Game.UI", "PlayerBar");
        g_class_PlayerNameCache = find_class("ScarletWork.Profile", "PlayerNameCache");
        g_class_WeaponController = find_class("ScarletWork.Weapon", "WeaponController");
        g_class_PlayerMovement  = find_class("", "PlayerMovement");
        g_class_Team            = find_class("", "Team");

        NSLog(@"[CFPlugin] Core classes: Cam=%p GO=%p XForm=%p Obj=%p V3=%p",
              g_class_Camera, g_class_GameObject, g_class_Transform,
              g_class_Object, g_class_Vector3);
        NSLog(@"[CFPlugin] Game classes: PlayerLife=%p PhotonPlayer=%p PN=%p Team=%p",
              g_class_PlayerLife, g_class_PhotonPlayer, g_class_PhotonNetwork, g_class_Team);

        // Cache methods
        if (g_class_Camera) {
            g_meth_WorldToScreenPoint = il2cpp_class_get_method_from_name(
                g_class_Camera, "WorldToScreenPoint", 1);
        }
        if (g_class_Object) {
            g_meth_FindObjectsOfType = il2cpp_class_get_method_from_name(
                g_class_Object, "FindObjectsOfType", 1);
        }
        if (g_class_PhotonNetwork) {
            g_meth_PlayerList_get = il2cpp_class_get_method_from_name(
                g_class_PhotonNetwork, "get_PlayerList", 0);
            g_meth_CurrentRoom_get = il2cpp_class_get_method_from_name(
                g_class_PhotonNetwork, "get_CurrentRoom", 0);
        }
        if (g_class_PlayerNumbering) {
            g_meth_GetTeam = il2cpp_class_get_method_from_name(
                g_class_PlayerNumbering, "GetTeam", 1);
        }

        NSLog(@"[CFPlugin] Methods: W2S=%p FindObjs=%p PList=%p GetTeam=%p",
              g_meth_WorldToScreenPoint, g_meth_FindObjectsOfType,
              g_meth_PlayerList_get, g_meth_GetTeam);

        g_initialized = YES;
        NSLog(@"[CFPlugin] ====== Initialization complete ======");

        // Hook Camera.OnPostRender for drawing
        // We use method swizzling on Unity's rendering
        // This is done via Logos %hook directives below
    });
}

/* ============================================================
 * Hook UnityAppController or EAGLView for reliable rendering
 * ============================================================ */

// Hook into Unity's EAGLView presentRenderbuffer for consistent drawing
%hook UnityAppController
- (void)repaintDisplayLink { 
    %orig;
    if (g_initialized && g_esp_enabled) {
        // We can render here if needed
    }
}
%end

// Alternative: hook CADisplayLink
%hook CADisplayLink
- (void)_callDelegates {
    %orig;
    render_esp();
}
%end
name: Build CFPlugin.dylib

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    
    steps:
    - name: Checkout
      uses: actions/checkout@v4

    - name: Setup theos
      run: |
        export THEOS=/opt/theos
        echo "THEOS=/opt/theos" >> $GITHUB_ENV
        if [ ! -d "$THEOS" ]; then
          git clone --depth 1 https://github.com/theos/theos.git $THEOS
        fi
        # Download iOS SDK
        curl -L -o sdk.zip https://github.com/theos/sdks/archive/master.zip
        unzip -o sdk.zip
        mkdir -p $THEOS/sdks
        cp -r sdks-master/* $THEOS/sdks/
        ls $THEOS/sdks/

    - name: Build dylib
      run: |
        export THEOS=/opt/theos
        make package FINALPACKAGE=1

    - name: Find dylib
      run: |
        find . -name "*.dylib" -type f 2>/dev/null
        ls -la .theos/obj/debug/arm64/ 2>/dev/null || true

    - name: Upload dylib artifact
      uses: actions/upload-artifact@v4
      with:
        name: CFPlugin-dylib
        path: |
          **/*.dylib
          packages/**/*.deb
        retention-days: 30
/**
 * CounterFlame ESP Plugin - Runtime IL2CPP Resolution
 * 
 * Dynamically resolves il2cpp functions from the game binary at runtime.
 * No compile-time il2cpp headers needed.
 * 
 * Target: arm64 iOS dylib injected into CounterFlame.app
 * 
 * ESP Features:
 *   - Corner box ESP with health bar, distance, name
 *   - Team color coding (blue/red)
 *   - Skeleton lines (bone ESP)
 *   - Snaplines from screen bottom
 *   - Head circle
 *   - Bomb/planted bomb indicator
 *   - Dropped weapon names
 */

#include <dlfcn.h>
#include <pthread.h>
#include <string.h>
#include <stdlib.h>
#include <stdio.h>
#include <math.h>
#include <unistd.h>

/* ============================================================
 * Types needed for IL2CPP runtime
 * ============================================================ */

typedef struct Il2CppObject Il2CppObject;
typedef struct Il2CppClass Il2CppClass;
typedef struct Il2CppDomain Il2CppDomain;
typedef struct Il2CppAssembly Il2CppAssembly;
typedef struct Il2CppImage Il2CppImage;
typedef struct Il2CppType Il2CppType;
typedef struct MethodInfo MethodInfo;
typedef struct FieldInfo FieldInfo;
typedef struct Il2CppString Il2CppString;
typedef struct PropertyInfo PropertyInfo;
typedef struct EventInfo EventInfo;

// Unity types we need
typedef float Vector3[3];
typedef float Vector2[2];
typedef float Matrix4x4[16];
typedef float Quaternion[4];
typedef uint32_t Color;
typedef int32_t Rect[4];

/* ============================================================
 * Function pointer types for il2cpp API
 * ============================================================ */

typedef Il2CppDomain* (*il2cpp_domain_get_t)(void);
typedef Il2CppAssembly** (*il2cpp_domain_get_assemblies_t)(Il2CppDomain* domain, size_t* size);
typedef Il2CppImage* (*il2cpp_assembly_get_image_t)(Il2CppAssembly* assembly);
typedef Il2CppClass* (*il2cpp_class_from_name_t)(Il2CppImage* image, const char* ns, const char* name);
typedef Il2CppClass* (*il2cpp_class_from_system_type_t)(Il2CppObject* type);
typedef Il2CppClass* (*il2cpp_class_get_parent_t)(Il2CppClass* klass);
typedef const char* (*il2cpp_class_get_name_t)(Il2CppClass* klass);
typedef const char* (*il2cpp_class_get_namespace_t)(Il2CppClass* klass);
typedef Il2CppObject* (*il2cpp_object_new_t)(Il2CppClass* klass);
