typedef Il2CppObject* (*il2cpp_gchandle_new_weakref_t)(Il2CppObject* obj, int trackResurrection);
typedef int (*il2cpp_is_destroyed_t)(Il2CppObject* obj);

/* ============================================================
 * Function pointers (resolved at runtime)
 * ============================================================ */

static il2cpp_domain_get_t              il2cpp_domain_get              = NULL;
static il2cpp_domain_get_assemblies_t   il2cpp_domain_get_assemblies   = NULL;
static il2cpp_assembly_get_image_t      il2cpp_assembly_get_image      = NULL;
static il2cpp_class_from_name_t         il2cpp_class_from_name         = NULL;
static il2cpp_class_from_system_type_t  il2cpp_class_from_system_type  = NULL;
static il2cpp_class_get_parent_t        il2cpp_class_get_parent        = NULL;
static il2cpp_class_get_name_t          il2cpp_class_get_name          = NULL;
static il2cpp_class_get_namespace_t     il2cpp_class_get_namespace     = NULL;
static il2cpp_object_new_t              il2cpp_object_new              = NULL;
static il2cpp_object_unbox_t            il2cpp_object_unbox            = NULL;
static il2cpp_value_box_t               il2cpp_value_box               = NULL;
static il2cpp_class_get_field_from_name_t il2cpp_class_get_field_from_name = NULL;
static il2cpp_class_get_fields_t        il2cpp_class_get_fields        = NULL;
static il2cpp_field_get_offset_t        il2cpp_field_get_offset        = NULL;
static il2cpp_field_get_value_t         il2cpp_field_get_value         = NULL;
static il2cpp_field_set_value_t         il2cpp_field_set_value         = NULL;
static il2cpp_field_static_get_value_t  il2cpp_field_static_get_value  = NULL;
static il2cpp_field_static_set_value_t  il2cpp_field_static_set_value  = NULL;
static il2cpp_class_get_method_from_name_t il2cpp_class_get_method_from_name = NULL;
static il2cpp_runtime_invoke_t          il2cpp_runtime_invoke          = NULL;
static il2cpp_string_new_t              il2cpp_string_new              = NULL;
static il2cpp_resolve_icall_t           il2cpp_resolve_icall           = NULL;
static il2cpp_gc_collect_t              il2cpp_gc_collect              = NULL;
static il2cpp_type_get_object_t         il2cpp_type_get_object         = NULL;
static il2cpp_object_get_class_t        il2cpp_object_get_class        = NULL;
static il2cpp_get_corlib_t              il2cpp_get_corlib              = NULL;
static il2cpp_array_new_t               il2cpp_array_new               = NULL;
static il2cpp_array_length_t            il2cpp_array_length            = NULL;
static il2cpp_class_from_il2cpp_type_t  il2cpp_class_from_il2cpp_type  = NULL;
static il2cpp_class_enum_basetype_t     il2cpp_class_enum_basetype     = NULL;
static il2cpp_runtime_object_init_t     il2cpp_runtime_object_init     = NULL;
static il2cpp_object_get_virtual_method_t il2cpp_object_get_virtual_method = NULL;
static il2cpp_gchandle_get_target_t     il2cpp_gchandle_get_target     = NULL;
static il2cpp_gchandle_new_t            il2cpp_gchandle_new            = NULL;
static il2cpp_gchandle_new_weakref_t    il2cpp_gchandle_new_weakref    = NULL;

/* ============================================================
 * Resolve a symbol from the main binary
 * ============================================================ */

static void* resolve_symbol(const char* name) {
    void* sym = dlsym(RTLD_DEFAULT, name);
    if (!sym) {
        printf("[CFPlugin] WARNING: Could not resolve %s: %s\n", name, dlerror());
    }
    return sym;
}

#define RESOLVE(name) name = (name ## _t) resolve_symbol(#name)

/* ============================================================
 * Init: resolve all il2cpp functions
 * ============================================================ */

static volatile int g_initialized = 0;
static Il2CppDomain* g_domain = NULL;
static Il2CppImage* g_corlib = NULL;
static Il2CppImage* g_game_assembly = NULL;

// Cached class handles
static Il2CppClass* g_class_Camera           = NULL;
static Il2CppClass* g_class_Transform        = NULL;
static Il2CppClass* g_class_GameObject       = NULL;
static Il2CppClass* g_class_Component        = NULL;
static Il2CppClass* g_class_Object           = NULL;
static Il2CppClass* g_class_PlayerLife       = NULL;
static Il2CppClass* g_class_PhotonPlayer     = NULL;
static Il2CppClass* g_class_PhotonNetwork    = NULL;
static Il2CppClass* g_class_PlayerController = NULL;
static Il2CppClass* g_class_Team             = NULL;
static Il2CppClass* g_class_WeaponController = NULL;
static Il2CppClass* g_class_PlayerNameCache  = NULL;
static Il2CppClass* g_class_PlayerFPSCamera  = NULL;
static Il2CppClass* g_class_GameManager      = NULL;
static Il2CppClass* g_class_PlayerSkeleton   = NULL;
static Il2CppClass* g_class_PlayerBar        = NULL;
static Il2CppClass* g_class_GUI              = NULL;
static Il2CppClass* g_class_GL               = NULL;
static Il2CppClass* g_class_PUN_Utility      = NULL;
static Il2CppClass* g_class_PlayerNumbering   = NULL;
static Il2CppClass* g_class_PlayerHull       = NULL;
static Il2CppClass* g_class_PlayerMovement   = NULL;

// Cached field offsets
static int g_offset_Transform_position    = -1;
static int g_offset_GameObject_name       = -1;
static int g_offset_Camera_main           = -1;
static int g_offset_PlayerLife_health     = -1;
static int g_offset_PlayerLife_maxHealth  = -1;
static int g_offset_PlayerLife_isAlive    = -1;
static int g_offset_PhotonPlayer_IsLocal  = -1;
static int g_offset_PhotonPlayer_NickName = -1;
static int g_offset_Team_teamEnum         = -1;
static int g_offset_PlayerBar_healthBar   = -1;

// Cached method pointers
static MethodInfo* g_method_Camera_get_main           = NULL;
static MethodInfo* g_method_Transform_get_position    = NULL;
static MethodInfo* g_method_Transform_get_forward     = NULL;
static MethodInfo* g_method_Component_GetComponent    = NULL;
static MethodInfo* g_method_GameObject_Find           = NULL;
static MethodInfo* g_method_GameObject_GetComponent   = NULL;
static MethodInfo* g_method_Object_FindObjectsOfType  = NULL;
static MethodInfo* g_method_PhotonNetwork_get_CurrentRoom = NULL;
static MethodInfo* g_method_PhotonNetwork_get_PlayerList = NULL;
static MethodInfo* g_method_PlayerNumbering_GetTeam   = NULL;
static MethodInfo* g_method_GUI_Box                   = NULL;
static MethodInfo* g_method_GUI_Label                 = NULL;

/* ============================================================
 * Logging utility
 * ============================================================ */

#define LOG(fmt, ...) printf("[CFPlugin] " fmt "\n", ##__VA_ARGS__)

/* ============================================================
 * Internal: find a game assembly by scanning loaded assemblies
 * ============================================================ */

static Il2CppImage* find_assembly(const char* partial_name) {
    if (!il2cpp_domain_get || !il2cpp_domain_get_assemblies || !il2cpp_assembly_get_image) {
        return NULL;
    }
    
    Il2CppDomain* domain = il2cpp_domain_get();
    if (!domain) {
        LOG("No IL2CPP domain");
        return NULL;
    }
    
    size_t assemblies_count = 0;
    Il2CppAssembly** assemblies = il2cpp_domain_get_assemblies(domain, &assemblies_count);
    if (!assemblies) {
        LOG("No assemblies found");
        return NULL;
    }
    
    for (size_t i = 0; i < assemblies_count; i++) {
        Il2CppImage* img = il2cpp_assembly_get_image(assemblies[i]);
        if (img) {
            const char* name = il2cpp_class_get_name ? 
                (const char*)il2cpp_class_get_name((Il2CppClass*)img) : NULL;
            if (name && strstr(name, partial_name)) {
                return img;
            }
        }
    }
    
    // Fall back: try using class_from_name with various assemblies
    // Assembly-CSharp is usually first
    if (assemblies_count > 0) {
        return il2cpp_assembly_get_image(assemblies[0]);
    }
    
    return NULL;
}

/* ============================================================
 * Find a class by name (tries multiple assemblies)
 * ============================================================ */

static Il2CppClass* find_class(const char* ns, const char* name) {
    if (!il2cpp_class_from_name) return NULL;
    
    Il2CppImage* images[] = { g_game_assembly, g_corlib, NULL };
    
    for (int i = 0; images[i] != NULL; i++) {
        Il2CppClass* klass = il2cpp_class_from_name(images[i], ns, name);
        if (klass) return klass;
    }
    
    // Try domain assemblies
    if (il2cpp_domain_get && il2cpp_domain_get_assemblies) {
        Il2CppDomain* domain = il2cpp_domain_get();
        if (domain) {
            size_t count = 0;
            Il2CppAssembly** asms = il2cpp_domain_get_assemblies(domain, &count);
            if (asms) {
                for (size_t i = 0; i < count; i++) {
                    Il2CppImage* img = il2cpp_assembly_get_image(asms[i]);
                    if (img == g_game_assembly || img == g_corlib) continue;
                    Il2CppClass* klass = il2cpp_class_from_name(img, ns, name);
                    if (klass) {
                        LOG("Found %s.%s in assembly %zu", ns, name, i);
                        return klass;
                    }
                }
            }
        }
    }
    
    return NULL;
}

/* ============================================================
 * Get a field offset from a class (with caching diagnostic)
 * ============================================================ */

static int get_field_offset(Il2CppClass* klass, const char* field_name) {
    if (!klass || !field_name || !il2cpp_class_get_field_from_name || !il2cpp_field_get_offset) {
        return -1;
    }
    
    FieldInfo* field = il2cpp_class_get_field_from_name(klass, field_name);
    if (!field) {
        // Try parent class
        if (il2cpp_class_get_parent) {
            Il2CppClass* parent = il2cpp_class_get_parent(klass);
            while (parent) {
                field = il2cpp_class_get_field_from_name(parent, field_name);
                if (field) break;
                parent = il2cpp_class_get_parent(parent);
            }
        }
        if (!field) {
            LOG("Field not found: %s", field_name);
            return -1;
        }
    }
    
    return (int)il2cpp_field_get_offset(field);
}

/* ============================================================
 * Read a field value from an object
 * ============================================================ */

static int32_t read_field_i32(Il2CppObject* obj, Il2CppClass* klass, const char* name) {
    int offset = get_field_offset(klass, name);
    if (offset < 0 || !obj) return 0;
    return *(int32_t*)((uint8_t*)obj + offset);
}

static float read_field_float(Il2CppObject* obj, Il2CppClass* klass, const char* name) {
    int offset = get_field_offset(klass, name);
    if (offset < 0 || !obj) return 0.0f;
    return *(float*)((uint8_t*)obj + offset);
}

static Il2CppObject* read_field_obj(Il2CppObject* obj, Il2CppClass* klass, const char* name) {
    int offset = get_field_offset(klass, name);
    if (offset < 0 || !obj) return NULL;
    return *(Il2CppObject**)((uint8_t*)obj + offset);
}

static void read_field_vec3(Il2CppObject* obj, Il2CppClass* klass, const char* name, float out[3]) {
    int offset = get_field_offset(klass, name);
    if (offset < 0 || !obj) {
        out[0] = out[1] = out[2] = 0.0f;
        return;
    }
    float* src = (float*)((uint8_t*)obj + offset);
    out[0] = src[0]; out[1] = src[1]; out[2] = src[2];
}

static int read_field_bool(Il2CppObject* obj, Il2CppClass* klass, const char* name) {
    int offset = get_field_offset(klass, name);
    if (offset < 0 || !obj) return 0;
    return *(uint8_t*)((uint8_t*)obj + offset) ? 1 : 0;
}

/* ============================================================
 * Read a string field (Il2CppString*)
 * ============================================================ */

static const char* read_string_field(Il2CppObject* obj, Il2CppClass* klass, const char* name) {
    int offset = get_field_offset(klass, name);
    if (offset < 0 || !obj) return NULL;
    
    Il2CppString* str = *(Il2CppString**)((uint8_t*)obj + offset);
    if (!str) return NULL;
    
    // Il2CppString: first 16 bytes are object header, then chars at offset 0x10 (or 0x14)
    // Actually: Il2CppString layout is { Il2CppObject header; int32_t length; char16_t chars[...]; }
    // chars start at offset 0x14 on 64-bit (8 byte header + 4 byte vtable ptr + 4 byte monitor + 4 byte length + 2 byte padding...)
    // The chars are UTF-16, so we need to convert
    
    int32_t length = *(int32_t*)((uint8_t*)str + 0x10);
    uint16_t* chars = (uint16_t*)((uint8_t*)str + 0x14);
    
    if (length <= 0 || length > 256) return "<invalid>";
    
    static char buf[256];
    int pos = 0;
    for (int i = 0; i < length && pos < 250; i++) {
        uint16_t c = chars[i];
        if (c < 0x80) {
            buf[pos++] = (char)c;
        } else if (c < 0x800) {
            if (pos + 1 < 250) {
                buf[pos++] = (char)(0xC0 | (c >> 6));
                buf[pos++] = (char)(0x80 | (c & 0x3F));
            }
        } else {
            if (pos + 2 < 250) {
                buf[pos++] = (char)(0xE0 | (c >> 12));
                buf[pos++] = (char)(0x80 | ((c >> 6) & 0x3F));
                buf[pos++] = (char)(0x80 | (c & 0x3F));
            }
        }
    }
    buf[pos] = '\0';
    return buf;
}

/* ============================================================
 * Get string from Il2CppString object
 * ============================================================ */

static const char* il2cpp_string_to_utf8(Il2CppString* str) {
    if (!str) return "<null>";
    int32_t length = *(int32_t*)((uint8_t*)str + 0x10);
    if (length <= 0 || length > 1024) return "<badlen>";
    uint16_t* chars = (uint16_t*)((uint8_t*)str + 0x14);
    static char buf[1024];
    int pos = 0;
    for (int i = 0; i < length && pos < 1000; i++) {
        uint16_t c = chars[i];
        if (c < 0x80) {
            buf[pos++] = (char)c;
        } else if (c < 0x800) {
            buf[pos++] = (char)(0xC0 | (c >> 6));
            buf[pos++] = (char)(0x80 | (c & 0x3F));
        } else {
            buf[pos++] = (char)(0xE0 | (c >> 12));
            buf[pos++] = (char)(0x80 | ((c >> 6) & 0x3F));
            buf[pos++] = (char)(0x80 | (c & 0x3F));
        }
    }
    buf[pos] = '\0';
    return buf;
}

