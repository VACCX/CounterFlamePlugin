/* ============================================================
 * Resolve il2cpp symbol from game binary
 * ============================================================ */
static void* resolve(const char* sym) {
    void* p = dlsym(RTLD_DEFAULT, sym);
    if (!p) NSLog(@"[CFPlugin] WARN: %s not found: %s", sym, dlerror());
    return p;
}
#define RESOLVE(x) x = (t_##x)resolve(#x)

/* ============================================================
 * Find a class across all assemblies
 * ============================================================ */
static Il2CppClass* find_class(const char* ns, const char* name) {
    if (!il2cpp_class_from_name) return NULL;
    Il2CppDomain* dom = il2cpp_domain_get();
    if (!dom) return NULL;
    size_t count = 0;
    Il2CppAssembly** asms = il2cpp_domain_get_assemblies(dom, &count);
    if (!asms) return NULL;
    for (size_t i = 0; i < count; i++) {
        Il2CppImage* img = il2cpp_assembly_get_image(asms[i]);
        if (!img) continue;
        Il2CppClass* k = il2cpp_class_from_name(img, ns, name);
        if (k) {
            NSLog(@"[CFPlugin] Found %s.%s in assembly %zu", ns, name, i);
            return k;
        }
    }
    return NULL;
}

/* ============================================================
 * Get field offset (searches parent classes too)
 * ============================================================ */
static int field_offset(Il2CppClass* k, const char* name) {
    if (!k || !il2cpp_class_get_field_from_name || !il2cpp_field_get_offset) return -1;
    Il2CppClass* cur = k;
    while (cur) {
        FieldInfo* f = il2cpp_class_get_field_from_name(cur, name);
        if (f) return (int)il2cpp_field_get_offset(f);
        cur = il2cpp_class_get_parent(cur);
    }
    return -1;
}

/* ============================================================
 * Read values from IL2CPP objects by field offset
 * ============================================================ */
static float    read_f32(Il2CppObject* obj, int off) { return obj ? *(float*)((uint8_t*)obj + off) : 0; }
static int32_t  read_i32(Il2CppObject* obj, int off) { return obj ? *(int32_t*)((uint8_t*)obj + off) : 0; }
static BOOL     read_bool(Il2CppObject* obj, int off) { return obj ? (*(uint8_t*)((uint8_t*)obj + off) != 0) : NO; }
static Il2CppObject* read_obj(Il2CppObject* obj, int off) { return obj ? *(Il2CppObject**)((uint8_t*)obj + off) : NULL; }
static void     read_vec3(Il2CppObject* obj, int off, float out[3]) {
    if (obj) { float* s = (float*)((uint8_t*)obj + off); out[0]=s[0]; out[1]=s[1]; out[2]=s[2]; }
    else { out[0]=out[1]=out[2]=0; }
}

/* ============================================================
 * Read Il2CppString -> UTF-8
 * Il2CppString layout: [Il2CppObject header 16B] [int32_t length] [uint16_t chars...]
 * On 64-bit arm64: chars start at offset 0x14 (16+4, no padding needed for packed layout)
 * Actually: object header is 8B (klass ptr) + 4B (monitor) = 12B, but aligned to 16B.
 * The length field is at offset 16, chars at offset 20.
 * But with natural alignment, many builds put length at 0x10 and chars at 0x14.
 * Let's try both. Most Unity IL2CPP 2022.x builds use: object header=16B, length=offset+16, chars=offset+20.
 */
static const char* str_utf8(Il2CppString* s) {
    if (!s) return "(null)";
    // Try both common layouts for Il2CppString on 64-bit
    int32_t len = *(int32_t*)((uint8_t*)s + 0x10);
    uint16_t* chars = (uint16_t*)((uint8_t*)s + 0x14);
    if (len < 0 || len > 512) {
        // Maybe it's the 0x14/0x18 layout (older)
        len = *(int32_t*)((uint8_t*)s + 0x14);
        chars = (uint16_t*)((uint8_t*)s + 0x18);
    }
    if (len <= 0 || len > 512) return "(bad)";
    static char buf[512];
    int p = 0;
    for (int i = 0; i < len && p < 500; i++) {
        uint16_t c = chars[i];
        if (c < 0x80) buf[p++] = (char)c;
        else if (c < 0x800) { if (p+1<500) { buf[p++]=0xC0|(c>>6); buf[p++]=0x80|(c&0x3F); } }
        else { if (p+2<500) { buf[p++]=0xE0|(c>>12); buf[p++]=0x80|((c>>6)&0x3F); buf[p++]=0x80|(c&0x3F); } }
    }
    buf[p] = 0;
    return buf;
}

/* ============================================================
 * Invoke a static method
 * ============================================================ */
static Il2CppObject* invoke_s(MethodInfo* m, void** args) {
    if (!m || !il2cpp_runtime_invoke) return NULL;
    Il2CppObject* exc = NULL;
    return il2cpp_runtime_invoke(m, NULL, args, &exc);
}

/* ============================================================
 * World to Screen using Camera.WorldToScreenPoint(Vector3)
 * ============================================================ */
static BOOL world_to_screen(Il2CppObject* cam, float wx, float wy, float wz, float* sx, float* sy, float* sz) {
    *sx = *sy = *sz = 0;
    if (!cam || !g_class_Vector3 || !g_meth_WorldToScreenPoint) return NO;

    float v3[3] = { wx, wy, wz };
    Il2CppObject* boxed = il2cpp_value_box(g_class_Vector3, v3);
    if (!boxed) return NO;

    void* args[] = { boxed };
    Il2CppObject* result = invoke_s(g_meth_WorldToScreenPoint, args);
    if (!result) return NO;

    float* r = il2cpp_object_unbox(result);
    if (!r) return NO;

    *sx = r[0]; *sy = r[1]; *sz = r[2];
    return YES;
}

/* ============================================================
 * Get Transform position from GameObject
 * ============================================================ */
static BOOL get_position(Il2CppObject* go, float out[3]) {
    out[0] = out[1] = out[2] = 0;
    if (!go) return NO;

    // GameObject -> transform field
    static int goff_transform = -1;
    if (goff_transform < 0) goff_transform = field_offset(g_class_GameObject, "m_Transform");
    if (goff_transform < 0) goff_transform = field_offset(g_class_GameObject, "transform");
    if (goff_transform < 0) {
        // Try component array
        goff_transform = field_offset(g_class_GameObject, "m_Component");
        if (goff_transform >= 0) {
            // m_Component is an array, first element is Transform
            Il2CppObject* compArr = read_obj(go, goff_transform);
            if (compArr) {
                Il2CppObject* xform = *(Il2CppObject**)((uint8_t*)compArr + 0x20); // first element
                if (xform) {
                    int posOff = field_offset(g_class_Transform, "m_Position");
                    if (posOff < 0) posOff = field_offset(g_class_Transform, "m_LocalPosition");
                    if (posOff >= 0) {
                        read_vec3(xform, posOff, out);
                        return YES;
                    }
                }
            }
        }
        return NO;
    }

    Il2CppObject* xform = read_obj(go, goff_transform);
    if (!xform) return NO;

    int posOff = field_offset(g_class_Transform, "m_Position");
    if (posOff < 0) posOff = field_offset(g_class_Transform, "m_LocalPosition");
    if (posOff >= 0) {
        read_vec3(xform, posOff, out);
        return YES;
    }
    return NO;
}

/* ============================================================
 * Collect all players
 * ============================================================ */
static void collect_players(void) {
    g_playerCount = 0;

    // Try Object.FindObjectsOfType with PlayerLife type
    if (!g_class_PlayerLife || !g_meth_FindObjectsOfType) return;

    // Get System.Type for PlayerLife
    Il2CppClass* typeClass = find_class("System", "Type");
    if (!typeClass) return;

    static MethodInfo* getType = NULL;
    if (!getType) getType = il2cpp_class_get_method_from_name(typeClass, "GetType", 1);
    if (!getType) return;

    Il2CppString* typeName = il2cpp_string_new("ScarletWork.Game.Life.PlayerLife, Assembly-CSharp");
    void* typeArgs[] = { typeName };
    Il2CppObject* playerLifeType = invoke_s(getType, typeArgs);
    if (!playerLifeType) {
        // Try without assembly suffix
        typeName = il2cpp_string_new("ScarletWork.Game.Life.PlayerLife");
        playerLifeType = invoke_s(getType, typeArgs);
    }
    if (!playerLifeType) return;

    void* findArgs[] = { playerLifeType };
    Il2CppObject* result = invoke_s(g_meth_FindObjectsOfType, findArgs);
    if (!result) return;

    uint32_t len = (uint32_t)il2cpp_array_length(result);
    if (len > MAX_PLAYERS * 2) len = MAX_PLAYERS * 2; // safety

    // Pre-compute field offsets
    static int off_health = -1, off_maxH = -1, off_alive = -1,
               off_go = -1, off_name = -1;

    if (off_health < 0) {
        off_health = field_offset(g_class_PlayerLife, "health");
        off_maxH   = field_offset(g_class_PlayerLife, "maxHealth");
        off_alive  = field_offset(g_class_PlayerLife, "isAlive");
        off_go     = field_offset(g_class_PlayerLife, "gameObject");
        // PlayerLife inherits from MonoBehaviour which has 'gameObject'
        // Actually MonoBehaviour.gameObject is a property, not a direct field
        // The internal field name might be different
        if (off_go < 0) off_go = field_offset(g_class_PlayerLife, "m_GameObject");
        if (off_go < 0) off_go = field_offset(g_class_PlayerLife, "_gameObject");
    }

    // Get main camera
    static int cam_main_off = -1;
    static Il2CppObject* mainCam = NULL;
    if (!mainCam) {
        if (cam_main_off < 0) cam_main_off = field_offset(g_class_Camera, "main");
        if (cam_main_off >= 0) {
            FieldInfo* mainField = il2cpp_class_get_field_from_name(g_class_Camera, "main");
            if (!mainField) mainField = il2cpp_class_get_field_from_name(g_class_Camera, "<main>k__BackingField");
            if (!mainField) mainField = il2cpp_class_get_field_from_name(g_class_Camera, "current");
            if (mainField) il2cpp_field_static_get_value(mainField, &mainCam);
        }
    }
    if (!mainCam) return;

    // Get PhotonNetwork.PlayerList for team info
    Il2CppObject* playerList = NULL;
    if (g_class_PhotonNetwork && g_meth_PlayerList_get) {
        playerList = invoke_s(g_meth_PlayerList_get, NULL);
    }

    for (uint32_t i = 0; i < len && g_playerCount < MAX_PLAYERS; i++) {
        Il2CppObject* pl = *(Il2CppObject**)((uint8_t*)result + 0x20 + i * 8);
        if (!pl) continue;

        PlayerInfo* pi = &g_players[g_playerCount];
        memset(pi, 0, sizeof(PlayerInfo));

        pi->health    = off_health >= 0 ? read_f32(pl, off_health) : 100.0f;
        pi->maxHealth = off_maxH >= 0   ? read_f32(pl, off_maxH) : 100.0f;
        pi->isAlive   = off_alive >= 0  ? read_bool(pl, off_alive) : YES;

        if (!pi->isAlive && pi->health <= 0) continue;

        pi->go = off_go >= 0 ? read_obj(pl, off_go) : NULL;

        // Get world position
        if (pi->go) {
            get_position(pi->go, pi->worldPos);
        }

        // World to screen (feet)
        world_to_screen(mainCam,
            pi->worldPos[0], pi->worldPos[1], pi->worldPos[2],
            &pi->screenPos[0], &pi->screenPos[1], &pi->screenPos[2]);

        // Head position (estimate: +1.8 units on Y)
        float hx, hy, hz;
        if (world_to_screen(mainCam,
            pi->worldPos[0], pi->worldPos[1] + 1.8f, pi->worldPos[2],
            &hx, &hy, &hz)) {
            pi->headScreen[0] = hx;
            pi->headScreen[1] = hy;
            pi->headScreen[2] = hz;
        }

        // Name from GameObject
        if (pi->go) {
            int nameOff = field_offset(g_class_GameObject, "name");
            if (nameOff < 0) nameOff = field_offset(g_class_GameObject, "m_Name");
            if (nameOff >= 0) {
                Il2CppString* ns = read_obj(pi->go, nameOff);
                const char* name = str_utf8(ns);
                if (name) strlcpy(pi->name, name, sizeof(pi->name));
            }
        }

        // Team from Photon PlayerNumbering
        if (g_class_PlayerNumbering && g_meth_GetTeam) {
            // PlayerNumbering.GetTeam(Photon.Realtime.Player)
            // Need to find the PhotonPlayer associated with this GameObject
            // For now, skip - will be refined after full metadata analysis
            pi->team = 0;
        }

        // Check if local
        pi->isLocal = NO;
        // Could check against PhotonNetwork.LocalPlayer

        g_playerCount++;
    }
}

