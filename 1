static CFOverlayWindow* g_overlayWindow = nil;
static CFOverlayView* g_overlayView = nil;
static CADisplayLink* g_displayLink = nil;

// Shared vertex buffer (written by CFPlugin render, read by MTKView delegate)
// This avoids complex synchronization - the display link reads the latest data
extern "C" {
    float g_overlayPositions[65536 * 2];  // x,y interleaved in NDC
    float g_overlayColors[65536 * 4];     // r,g,b,a interleaved
    int g_overlayVertexCount = 0;
    int g_readyToDraw = 0;
}

void CFOverlay_Init(void) {
    if (g_overlayWindow) return;  // Already initialized
    
    NSLog(@"[CFOverlay] Initializing overlay window...");
    
    // Run on main thread
    dispatch_async(dispatch_get_main_queue(), ^{
        // Create a transparent window ABOVE everything
        UIScreen* screen = [UIScreen mainScreen];
        CGRect bounds = screen.bounds;
        
        g_overlayWindow = [[CFOverlayWindow alloc] initWithFrame:bounds];
        g_overlayWindow.windowLevel = UIWindowLevelAlert + 100;  // Above game
        g_overlayWindow.backgroundColor = [UIColor clearColor];
        g_overlayWindow.opaque = NO;
        g_overlayWindow.rootViewController = [[UIViewController alloc] init];
        g_overlayWindow.rootViewController.view.backgroundColor = [UIColor clearColor];
        g_overlayWindow.rootViewController.view.userInteractionEnabled = NO;
        g_overlayWindow.hidden = NO;
        
        // Create MTKView for drawing
        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
        if (!device) {
            NSLog(@"[CFOverlay] ERROR: Could not create Metal device!");
            return;
        }
        
        g_overlayView = [[CFOverlayView alloc] initWithFrame:bounds device:device];
        g_overlayView.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        [g_overlayWindow.rootViewController.view addSubview:g_overlayView];
        
        NSLog(@"[CFOverlay] Overlay window created successfully");
        NSLog(@"[CFOverlay] Window level: %.0f", g_overlayWindow.windowLevel);
        
        // Listen for orientation changes to update dimensions
        [[NSNotificationCenter defaultCenter] addObserverForName:UIDeviceOrientationDidChangeNotification
                                                          object:nil
                                                           queue:[NSOperationQueue mainQueue]
                                                      usingBlock:^(NSNotification* note) {
            CGRect newBounds = [UIScreen mainScreen].bounds;
            g_overlayWindow.frame = newBounds;
            g_overlayView.frame = newBounds;
            CFPlugin_SetScreenSize(newBounds.size.width * screen.scale,
                                   newBounds.size.height * screen.scale);
        }];
        
        // Set initial screen size
        CFPlugin_SetScreenSize(bounds.size.width * screen.scale,
                               bounds.size.height * screen.scale);
        
        NSLog(@"[CFOverlay] Screen: %.0fx%.0f @ %.0fx",
              bounds.size.width * screen.scale,
              bounds.size.height * screen.scale,
              screen.scale);
    });
    
    NSLog(@"[CFOverlay] Init dispatched to main thread");
}

void CFOverlay_SubmitVertices(const float* positions, const float* colors, int count) {
    if (count > 65536) count = 65536;
    if (count <= 0) {
        g_overlayVertexCount = 0;
        g_readyToDraw = 0;
        return;
    }
    
    memcpy(g_overlayPositions, positions, count * 2 * sizeof(float));
    memcpy(g_overlayColors, colors, count * 4 * sizeof(float));
    g_overlayVertexCount = count;
    g_readyToDraw = 1;
}

void CFOverlay_Shutdown(void) {
    dispatch_async(dispatch_get_main_queue(), ^{
        g_overlayWindow.hidden = YES;
        g_overlayWindow = nil;
        g_overlayView = nil;
        g_readyToDraw = 0;
        NSLog(@"[CFOverlay] Shutdown");
    });
}
//
//  UnityBridge.mm - Hooks into Unity's rendering to get camera matrices
//  and player data for the ESP overlay.
//
//  This file hooks Unity's Camera rendering functions at the native level
//  to extract view/projection matrices automatically.
//

#import "CFPlugin.h"
#import <dlfcn.h>
#import <mach-o/dyld.h>
#import <objc/runtime.h>
#import <objc/message.h>

// ============================================================
// Unity internal types (from Unity runtime source)
// ============================================================

// Unity uses column-major 4x4 matrices
typedef float Matrix4x4[16];

// Unity Camera native object (opaque)
typedef struct UnityCamera UnityCamera;

// Unity Transform access
typedef struct {
    float x, y, z;
} Vector3f;

// ============================================================
// Function pointers to Unity internal functions
// ============================================================

// Camera functions
typedef Matrix4x4* (*GetCameraViewMatrixFunc)(void* camera);
typedef Matrix4x4* (*GetCameraProjectionMatrixFunc)(void* camera);
typedef void* (*GetMainCameraFunc)(void);

// GameObject functions
typedef void* (*GameObjectFindFunc)(const char* name);
typedef void* (*GameObjectGetTransformFunc)(void* go);
typedef Vector3f* (*TransformGetPositionFunc)(void* transform);

static GetMainCameraFunc g_unity_GetMainCamera = NULL;
static GetCameraViewMatrixFunc g_unity_GetCameraView = NULL;
static GetCameraProjectionMatrixFunc g_unity_GetCameraProjection = NULL;
static GameObjectFindFunc g_unity_GameObjectFind = NULL;

// ============================================================
// Unity Framework function resolver
// ============================================================

static void* UnityResolve(const char* name) {
    // Try to find the function in UnityFramework
    // Unity exports these symbols or we can find them via pattern matching
    
    // First try direct dlsym
    void* ptr = dlsym(RTLD_DEFAULT, name);
    if (ptr) return ptr;
    
    // Try UnityFramework specifically
    // The UnityFramework is loaded as a dynamic library
    for (uint32_t i = 0; i < _dyld_image_count(); i++) {
        const char* imageName = _dyld_get_image_name(i);
        if (imageName && strstr(imageName, "UnityFramework")) {
            void* handle = dlopen(imageName, RTLD_NOLOAD | RTLD_LAZY);
            if (handle) {
                ptr = dlsym(handle, name);
                if (ptr) return ptr;
            }
            break;
        }
    }
    
    // Try common Unity symbol manglings
    char mangledName[256];
    
    // Try with C++ mangling
    snprintf(mangledName, sizeof(mangledName), "_Z%s", name);
    ptr = dlsym(RTLD_DEFAULT, mangledName);
    if (ptr) return ptr;
    
    // Try various IL2CPP exports
    // il2cpp_* functions are exported
    ptr = dlsym(RTLD_DEFAULT, "il2cpp_init");
    if (!ptr) {
        // Not IL2CPP or symbols are stripped
    }
    
    return NULL;
}

// ============================================================
// Camera matrix extraction via Metal hook
// ============================================================

// Alternative approach: Hook Unity's GfxDevice metal rendering
// Unity calls into UnityMetalSupport.mm for Metal rendering
// We can hook the function that sets up the camera's MVP matrix

typedef struct {
    float mvp[16];
    float view[16];
    float proj[16];
} UnityFrameState;

static UnityFrameState g_frameState;

// ============================================================
// Unity Camera component hook
// ============================================================

// In Unity IL2CPP, Camera.main calls Camera_get_main() internally
// We can hook the function that applies the camera's view/projection

// The key function chain in Unity rendering:
// Camera::Render() -> SetupCameraMatrices() -> SetViewMatrix() / SetProjectionMatrix()
// These eventually call into the graphics device (Metal)

// For a practical approach without full Unity SDK symbols:
// We monitor the game screen via Metal and use screen-space only
// For WorldToScreen, we need matrices which require either:
//   a) Hooking Unity's internal functions
//   b) Reading the matrices from Unity memory
//   c) Computing them from screen observations

// ============================================================
// Practical approach: Hook Metal shader constants
// ============================================================

// Unity uploads the VP matrix as a uniform to every shader
// By hooking MTLRenderCommandEncoder setVertexBytes or setVertexBuffer,
// we can intercept the MVP matrix

static BOOL g_matrixCaptureEnabled = YES;
static float g_capturedMVPMatrix[16] = {0};
static float g_capturedViewMatrix[16] = {0};
static float g_capturedProjMatrix[16] = {0};

// Hook function for setVertexBytes (captures constant buffer data)
typedef void (*SetVertexBytesFunc)(id, SEL, const void*, NSUInteger, NSUInteger);

static SetVertexBytesFunc g_orig_setVertexBytes = NULL;

static void cf_hook_setVertexBytes(id self, SEL _cmd, const void* bytes, NSUInteger length, NSUInteger index) {
    // Check if this looks like a 4x4 matrix (64 bytes)
    if (g_matrixCaptureEnabled && length == 64 && index == 0) {
        const float* matrix = (const float*)bytes;
        
        // Check if the matrix looks like a valid projection/view matrix
        // VP matrices typically have values in [-2, 2] range
        BOOL looksLikeMatrix = YES;
        for (int i = 0; i < 16; i++) {
            if (fabsf(matrix[i]) > 100.0f) {
                looksLikeMatrix = NO;
                break;
            }
        }
        
        if (looksLikeMatrix) {
            memcpy(g_capturedMVPMatrix, matrix, 64);
            // Update the global matrices
            CFPlugin_SetProjectionMatrix(g_capturedMVPMatrix);
            // For our overlay, the MVP can be used as a combined VP
            // We use the same for both view and projection
            CFPlugin_SetViewMatrix(g_capturedMVPMatrix);
        }
    }
    
    // Call original
    if (g_orig_setVertexBytes) {
        g_orig_setVertexBytes(self, _cmd, bytes, length, index);
    }
}

// ============================================================
// Auto-initialize Unity bridge
// ============================================================

__attribute__((constructor))
static void UnityBridgeInit(void) {
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2.0 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
        NSLog(@"[CFPlugin] UnityBridge initializing...");
        
        // Try to resolve Unity functions
        // These are common Unity exports that may exist
        const char* unityFuncs[] = {
            "Camera_get_main",
            "Camera_GetCurrent",
            "Camera_get_worldToCameraMatrix",
            "Camera_get_projectionMatrix",
            "il2cpp_object_new",
            "il2cpp_runtime_invoke",
            NULL
        };
        
        for (int i = 0; unityFuncs[i]; i++) {
            void* ptr = UnityResolve(unityFuncs[i]);
            if (ptr) {
                NSLog(@"[CFPlugin] Found: %s @ %p", unityFuncs[i], ptr);
            }
        }
        
        // Install Metal uniform hook for matrix capture
        Class mtlEncoder = objc_getClass("MTLRenderCommandEncoder");
        if (!mtlEncoder) {
            mtlEncoder = objc_getClass("AGXG15FamilyRenderCommandEncoder");
        }
        if (!mtlEncoder) {
            mtlEncoder = objc_getClass("AGXRenderCommandEncoder");
        }
        
        if (mtlEncoder) {
            SEL setVertexBytesSel = sel_registerName("setVertexBytes:length:atIndex:");
            Method method = class_getInstanceMethod(mtlEncoder, setVertexBytesSel);
            if (method) {
                g_orig_setVertexBytes = (SetVertexBytesFunc)method_getImplementation(method);
                method_setImplementation(method, (IMP)cf_hook_setVertexBytes);
                NSLog(@"[CFPlugin] Installed Metal uniform hook on %s", class_getName(mtlEncoder));
            }
        } else {
            NSLog(@"[CFPlugin] Warning: Could not find MTLRenderCommandEncoder class");
        }
        
        // Get screen size
        UIScreen* mainScreen = [UIScreen mainScreen];
        CGFloat scale = mainScreen.scale;
        CGSize size = mainScreen.bounds.size;
        CFPlugin_SetScreenSize(size.width * scale, size.height * scale);
        
        NSLog(@"[CFPlugin] Screen size: %.0fx%.0f @ %.0fx", 
              size.width * scale, size.height * scale, scale);
        
        // Listen for screen size changes (rotation etc)
        [[NSNotificationCenter defaultCenter] addObserverForName:UIApplicationDidChangeStatusBarOrientationNotification
                                                          object:nil
                                                           queue:[NSOperationQueue mainQueue]
                                                      usingBlock:^(NSNotification* note) {
            UIScreen* screen = [UIScreen mainScreen];
            CGFloat s = screen.scale;
            CGSize sz = screen.bounds.size;
            CFPlugin_SetScreenSize(sz.width * s, sz.height * s);
        }];
        
        NSLog(@"[CFPlugin] UnityBridge initialized");
    });
}

