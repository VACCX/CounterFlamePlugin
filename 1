//
//  OverlayWindow.mm - Transparent overlay window for ESP rendering
//
//  This provides a MUCH more reliable alternative to Metal hooking.
//  Instead of swizzling MTLCommandBuffer (which may fail on some
//  iOS versions or GPU families), we create a transparent UIWindow
//  on top of the game that renders the ESP overlay independently.
//
//  Advantages:
//  - No Metal hooking = no compatibility issues
//  - Uses official iOS APIs (CADisplayLink + MTKView)
//  - Independent rendering pipeline
//  - Touch passthrough (doesn't interfere with game input)
//

#import "CFPlugin.h"
#import <MetalKit/MetalKit.h>
#import <UIKit/UIKit.h>

// ============================================================
// Overlay MTKView
// ============================================================

@interface CFOverlayView : MTKView <MTKViewDelegate>
@end

@implementation CFOverlayView {
    id<MTLDevice> _device;
    id<MTLCommandQueue> _commandQueue;
    id<MTLRenderPipelineState> _pipeline;
}

- (instancetype)initWithFrame:(CGRect)frame device:(id<MTLDevice>)device {
    self = [super initWithFrame:frame device:device];
    if (self) {
        _device = device;
        _commandQueue = [device newCommandQueue];
        
        // Configure for transparent overlay
        self.delegate = self;
        self.enableSetNeedsDisplay = NO;
        self.paused = NO;
        self.framebufferOnly = NO;
        self.clearColor = MTLClearColorMake(0, 0, 0, 0);  // Transparent
        self.backgroundColor = [UIColor clearColor];
        self.opaque = NO;
        self.userInteractionEnabled = NO;  // Pass touches through
        
        // Allow transparency
        self.layer.opaque = NO;
        
        // Compile shaders
        [self setupPipeline];
        
        NSLog(@"[CFOverlay] MTKView created: %.0fx%.0f", frame.size.width, frame.size.height);
    }
    return self;
}

- (void)setupPipeline {
    MTLCompileOptions* opts = [[MTLCompileOptions alloc] init];
    
    NSString* shaderSrc = @""
    "#include <metal_stdlib>\n"
    "using namespace metal;\n"
    "struct v2f { float4 pos [[position]]; float4 color; };\n"
    "vertex v2f vs(uint vid [[vertex_id]],\n"
    "              device const float2* pos [[buffer(0)]],\n"
    "              device const float4* color [[buffer(1)]]) {\n"
    "    v2f o;\n"
    "    o.pos = float4(pos[vid], 0.0, 1.0);\n"
    "    o.color = color[vid];\n"
    "    return o;\n"
    "}\n"
    "fragment float4 fs(v2f i [[stage_in]]) {\n"
    "    return i.color;\n"
    "}\n";
    
    NSError* err = nil;
    id<MTLLibrary> lib = [_device newLibraryWithSource:shaderSrc options:opts error:&err];
    if (!lib) {
        NSLog(@"[CFOverlay] Shader compile error: %@", err);
        return;
    }
    
    MTLRenderPipelineDescriptor* desc = [[MTLRenderPipelineDescriptor alloc] init];
    desc.vertexFunction = [lib newFunctionWithName:@"vs"];
    desc.fragmentFunction = [lib newFunctionWithName:@"fs"];
    desc.colorAttachments[0].pixelFormat = MTLPixelFormatBGRA8Unorm;
    desc.colorAttachments[0].blendingEnabled = YES;
    desc.colorAttachments[0].sourceRGBBlendFactor = MTLBlendFactorSourceAlpha;
    desc.colorAttachments[0].destinationRGBBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
    desc.colorAttachments[0].sourceAlphaBlendFactor = MTLBlendFactorSourceAlpha;
    desc.colorAttachments[0].destinationAlphaBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
    
    _pipeline = [_device newRenderPipelineStateWithDescriptor:desc error:&err];
    if (!_pipeline) {
        NSLog(@"[CFOverlay] Pipeline error: %@", err);
    }
}

- (void)mtkView:(MTKView *)view drawableSizeWillChange:(CGSize)size {
    // Handle resize
}

- (void)drawInMTKView:(MTKView *)view {
    // Called each frame by MTKView's internal CADisplayLink
    @autoreleasepool {
        if (!_pipeline) return;
        
        // Call the ESP render function to prepare vertex data
        // This is declared in CFPlugin.mm
        extern void CFRenderOverlay(void);
        CFRenderOverlay();
        
        // Read the vertex data prepared by CFPlugin
        if (!g_readyToDraw || g_overlayVertexCount < 3) return;
        
        id<MTLCommandBuffer> cmdBuf = [_commandQueue commandBuffer];
        MTLRenderPassDescriptor* pass = view.currentRenderPassDescriptor;
        if (!pass) return;
        
        pass.colorAttachments[0].loadAction = MTLLoadActionClear;
        pass.colorAttachments[0].clearColor = MTLClearColorMake(0, 0, 0, 0);
        
        id<MTLRenderCommandEncoder> enc = [cmdBuf renderCommandEncoderWithDescriptor:pass];
        [enc setRenderPipelineState:_pipeline];
        
        // Get vertex data (position + color interleaved)
        int vtxCount = g_overlayVertexCount;
        size_t posSize = vtxCount * sizeof(float) * 2;
        size_t colSize = vtxCount * sizeof(float) * 4;
        
        if (vtxCount > 0) {
            id<MTLBuffer> posBuf = [_device newBufferWithBytes:g_overlayPositions
                                                        length:posSize
                                                       options:MTLResourceCPUCacheModeWriteCombined];
            id<MTLBuffer> colBuf = [_device newBufferWithBytes:g_overlayColors
                                                        length:colSize
                                                       options:MTLResourceCPUCacheModeWriteCombined];
            
            [enc setVertexBuffer:posBuf offset:0 atIndex:0];
            [enc setVertexBuffer:colBuf offset:0 atIndex:1];
            [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:vtxCount];
        }
        
        [enc endEncoding];
        [cmdBuf presentDrawable:view.currentDrawable];
        [cmdBuf commit];
    }
}

@end

