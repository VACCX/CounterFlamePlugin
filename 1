    LOG("  PlayerController: %p", g_class_PlayerController);
    LOG("  PhotonPlayer: %p", g_class_PhotonPlayer);
    LOG("  PlayerFPSCamera: %p", g_class_PlayerFPSCamera);
    LOG("  PlayerSkeleton: %p", g_class_PlayerSkeleton);
    LOG("  PlayerBar: %p", g_class_PlayerBar);
    LOG("  PlayerNameCache: %p", g_class_PlayerNameCache);
    LOG("  PlayerHull: %p", g_class_PlayerHull);
    LOG("  PlayerMovement: %p", g_class_PlayerMovement);
    LOG("  Team: %p", g_class_Team);
    LOG("  WeaponController: %p", g_class_WeaponController);
    LOG("  GameManager: %p", g_class_GameManager);
    
    // Try to find PUN utility classes
    g_class_PUN_Utility = find_class("Photon.Pun.UtilityScripts", "PlayerNumbering");
    g_class_PlayerNumbering = g_class_PUN_Utility;
    if (!g_class_PUN_Utility) {
        g_class_PUN_Utility = find_class("Photon.Pun", "PhotonNetwork");
    }
    LOG("  PUN Utility: %p", g_class_PUN_Utility);
    
    g_initialized = 1;
    LOG("Plugin initialization complete!");
    LOG("================================================");
    
    // Start ESP update thread
    g_running = 1;
    pthread_create(&g_esp_thread, NULL, esp_thread_func, NULL);
}

/* ============================================================
 * Cleanup on unload
 * ============================================================ */

__attribute__((destructor))
static void cf_plugin_cleanup(void) {
    LOG("Plugin unloading...");
    g_running = 0;
    if (g_esp_thread) {
        pthread_join(g_esp_thread, NULL);
    }
    LOG("Plugin unloaded");
}
